---
// ============================================================
// BLOCO DE NEWSLETTER — ativo e conectado ao sistema próprio
// (Netlify Function /inscrever → Blobs → Resend)
// ============================================================
const formEmbedHtml = `
<form method="POST" action="/.netlify/functions/inscrever" class="nl-form">
  <input type="text" name="website" class="nl-honeypot" tabindex="-1" autocomplete="off" aria-hidden="true" />
  <input type="email" name="email" required placeholder="Seu melhor e-mail" class="nl-input" />
  <button type="submit" class="nl-btn">Inscrever</button>
</form>
<p class="nl-privacy">Sem spam. Você pode cancelar com 1 clique, a qualquer momento.</p>
`;
---
{
  formEmbedHtml && (
    <section class="newsletter" aria-label="Assine a newsletter">
      <div class="newsletter-card">
        <p class="newsletter-eyebrow">Newsletter</p>
        <h2>Receba os novos artigos em primeira mão</h2>
        <p class="newsletter-text">
          Toda vez que eu publicar um texto novo, você recebe direto no seu
          e-mail. Sem spam — só reflexões para uma vida mais leve e
          consciente.
        </p>
        <div class="newsletter-form" set:html={formEmbedHtml} />
      </div>
    </section>
  )
}
<style>
  .newsletter {
    @apply mx-auto w-full max-w-5xl px-4 pb-4 pt-12;
  }
  .newsletter-card {
    @apply rounded-2xl border border-skin-line bg-skin-card p-8 text-center sm:p-10;
  }
  .newsletter-eyebrow {
    @apply mb-2 text-xs font-medium uppercase tracking-[0.2em] text-skin-accent;
  }
  .newsletter-card h2 {
    @apply text-xl font-semibold sm:text-2xl;
  }
  .newsletter-text {
    @apply mx-auto mt-3 max-w-md text-sm leading-relaxed opacity-80;
  }
  .newsletter-form {
    @apply mt-6;
  }
  .newsletter-form :global(.nl-form) {
    @apply mx-auto flex max-w-md flex-col gap-3 sm:flex-row;
  }
  .newsletter-form :global(.nl-input) {
    @apply w-full flex-1 rounded-full border border-skin-line bg-skin-fill px-5 py-3 text-sm text-skin-base outline-none focus:border-skin-accent;
  }
  .newsletter-form :global(.nl-btn) {
    @apply rounded-full bg-skin-accent px-6 py-3 text-sm font-medium text-skin-inverted transition-opacity hover:opacity-90;
  }
  .newsletter-form :global(.nl-honeypot) {
    @apply hidden;
  }
  .newsletter-form :global(.nl-privacy) {
    @apply mt-3 text-xs opacity-60;
  }
</style>