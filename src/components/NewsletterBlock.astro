---
// ============================================================
// BLOCO DE NEWSLETTER — ativo e conectado ao sistema próprio
// (Netlify Function /inscrever → Blobs → Resend)
// ============================================================
const formEmbedHtml = `
<form method="POST" action="/.netlify/functions/inscrever" class="nl-form" id="nl-form">
  <input type="text" name="website" class="nl-honeypot" tabindex="-1" autocomplete="off" aria-hidden="true" />
  <input type="email" name="email" required placeholder="Seu melhor e-mail" class="nl-input" autocapitalize="off" autocorrect="off" spellcheck="false" />
  <button type="submit" class="nl-btn">Inscrever</button>
</form>
<div class="nl-success display-none" id="nl-success">
  <p class="nl-success-title">Inscrição confirmada! 🎉</p>
  <p class="nl-success-text">A partir de agora, os novos artigos chegam direto no seu e-mail. Confira sua caixa de entrada — acolhimento em breve!</p>
</div>
<p class="nl-error display-none" id="nl-error"><span id="nl-error-msg">Ops — este e-mail não parece válido. Tente novamente, por favor.</span></p>
<p class="nl-privacy" id="nl-privacy">Sem spam. Você pode cancelar com 1 clique, a qualquer momento.</p>
`;
---
{
  formEmbedHtml && (
    <section class="newsletter" aria-label="Assine a newsletter" id="newsletter">
      <div class="newsletter-card">
        <p class="newsletter-eyebrow">Newsletter</p>
        <h2>Receba os novos artigos em primeira mão</h2>
        <p class="newsletter-text">
          Toda vez que eu publicar um texto novo, você recebe direto no seu
          e-mail. Sem spam — só reflexões para uma vida mais leve e
          consciente.
        </p>
        <div class="newsletter-form" set:html={formEmbedHtml} />
      </div>
    </section>
  )
}
<style>
  .newsletter {
    @apply mx-auto w-full max-w-5xl px-4 pb-4 pt-12;
  }
  .newsletter-card {
    @apply rounded-2xl border border-skin-line bg-skin-card p-8 text-center sm:p-10;
  }
  .newsletter-eyebrow {
    @apply mb-2 text-xs font-medium uppercase tracking-[0.2em] text-skin-accent;
  }
  .newsletter-card h2 {
    @apply text-xl font-semibold sm:text-2xl;
  }
  .newsletter-text {
    @apply mx-auto mt-3 max-w-md text-sm leading-relaxed opacity-80;
  }
  .newsletter-form {
    @apply mt-6;
  }
  .newsletter-form :global(.nl-form) {
    @apply mx-auto flex max-w-md flex-col gap-3 sm:flex-row;
  }
  .newsletter-form :global(.nl-input) {
    @apply w-full flex-1 rounded-full border border-skin-line bg-skin-fill px-5 py-3 text-sm text-skin-base outline-none focus:border-skin-accent;
  }
  .newsletter-form :global(.nl-btn) {
    @apply rounded-full bg-skin-accent px-6 py-3 text-sm font-medium text-skin-inverted transition-opacity hover:opacity-90;
  }
  .newsletter-form :global(.nl-honeypot) {
    @apply hidden;
  }
  .newsletter-form :global(.nl-privacy) {
    @apply mt-3 text-xs opacity-60;
  }
  .newsletter-form :global(.nl-success) {
    @apply mx-auto mt-6 max-w-md rounded-xl border border-skin-accent bg-skin-fill p-4;
  }
  .newsletter-form :global(.nl-success-title) {
    @apply m-0 font-semibold text-skin-accent;
  }
  .newsletter-form :global(.nl-success-text) {
    @apply m-0 mt-1 text-sm opacity-80;
  }
  .newsletter-form :global(.nl-error) {
    @apply mx-auto mt-6 max-w-md rounded-xl border border-red-400 bg-skin-fill p-4 text-sm text-red-600;
  }
</style>
<script>
  // Mostra a confirmação/erro quando a função redireciona de volta
  function newsletterFeedback() {
    const params = new URLSearchParams(window.location.search);
    const status = params.get("newsletter");
    if (!status) return;
    const section = document.getElementById("newsletter");
    const form = document.getElementById("nl-form");
    const success = document.getElementById("nl-success");
    const error = document.getElementById("nl-error");
    const privacy = document.getElementById("nl-privacy");
    if (status === "ok" && success) {
      form?.classList.add("display-none");
      privacy?.classList.add("display-none");
      success.classList.remove("display-none");
    } else if (status === "erro" && error) {
      const received = params.get("email");
      const msg = document.getElementById("nl-error-msg");
      if (msg && received) {
        msg.textContent = `Recebemos “${received}”, que não parece um e-mail válido. Confira se foi digitado corretamente (ex.: nome@gmail.com) e tente de novo.`;
      }
      error.classList.remove("display-none");
    }
    // leva o usuário direto ao bloco (sem depender da âncora do redirect)
    section?.scrollIntoView({ behavior: "smooth", block: "start" });
    // limpa a URL para o recarregar não repetir a mensagem
    window.history.replaceState({}, "", window.location.pathname + "#newsletter");
  }
  newsletterFeedback();
  document.addEventListener("astro:after-swap", newsletterFeedback);
</script>