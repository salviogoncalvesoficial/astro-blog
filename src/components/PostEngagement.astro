---
const { slug } = Astro.props;
---
<section class="post-engagement" data-like-box data-slug={slug} aria-label="Interação com o artigo">
  <div class="like-area"><p class="like-question">Este texto fez sentido para você?</p><button class="like-button" type="button" data-like-button aria-pressed="false"><span class="like-heart" aria-hidden="true">♡</span><span data-like-label>Gostei deste artigo</span></button><p class="like-count" data-like-count hidden></p></div>
  <div class="like-newsletter" data-like-newsletter hidden><p class="like-thanks">Você gostou deste artigo.</p><p class="like-invite">Se este texto fez sentido para você, continue por perto. Novas reflexões chegarão diretamente no seu e-mail.</p><form class="like-newsletter-form" data-like-form novalidate><input type="text" name="website" class="like-honeypot" tabindex="-1" autocomplete="off" aria-hidden="true" /><input type="email" name="email" required placeholder="Seu melhor e-mail" aria-label="Seu melhor e-mail" /><button type="submit">Quero receber novas reflexões</button></form><p class="like-newsletter-feedback" data-like-feedback role="status"></p><p class="like-privacy">Sem spam. Você pode cancelar com 1 clique, a qualquer momento.</p></div>
</section>
<style>
.post-engagement{margin-top:3rem;border-top:1px solid rgb(var(--color-line));border-bottom:1px solid rgb(var(--color-line));padding:2rem 0;text-align:center}.like-question{margin:0 0 .9rem;font-size:.95rem;opacity:.8}.like-button{display:inline-flex;align-items:center;gap:.55rem;border:1px solid rgb(var(--color-accent));border-radius:999px;background:transparent;padding:.7rem 1.2rem;color:rgb(var(--color-accent));font-size:.9rem;cursor:pointer;transition:background .2s,color .2s}.like-button:hover{background:rgb(var(--color-accent)/.09)}.like-button.is-liked{background:rgb(var(--color-accent));color:rgb(var(--color-inverted))}.like-heart{font-size:1.35rem;line-height:.8}.like-count{margin:.7rem 0 0;font-size:.75rem;opacity:.65}.like-newsletter{margin:1.6rem auto 0;max-width:34rem;border-radius:1rem;background:rgb(var(--color-card-muted)/.55);padding:1.4rem 1.2rem}.like-thanks{margin:0;color:rgb(var(--color-accent));font-weight:600}.like-invite{margin:.45rem auto 1rem;max-width:29rem;font-size:.9rem;line-height:1.55;opacity:.8}.like-newsletter-form{display:flex;flex-direction:column;gap:.6rem;margin:auto;max-width:28rem}.like-newsletter-form input{width:100%;border:1px solid rgb(var(--color-line));border-radius:999px;background:rgb(var(--color-fill));padding:.7rem 1rem;color:rgb(var(--color-base));font-size:.85rem;outline:none}.like-newsletter-form button{border:0;border-radius:999px;background:rgb(var(--color-accent));padding:.7rem 1rem;color:rgb(var(--color-inverted));font-size:.82rem;cursor:pointer}.like-newsletter-form button:disabled{opacity:.6}.like-newsletter-feedback{min-height:1.2rem;margin:.8rem 0 0;font-size:.82rem;color:rgb(var(--color-accent))}.like-newsletter-feedback.error{color:#b45353}.like-privacy{margin:.6rem 0 0;font-size:.7rem;opacity:.55}.like-honeypot{display:none!important}@media(min-width:640px){.like-newsletter-form{flex-direction:row}.like-newsletter-form input{flex:1}.like-newsletter-form button{white-space:nowrap}}
</style>
<script>
(() => {
 function bindPostLike(){
  const box=document.querySelector("[data-like-box]");if(!box||box.dataset.bound==="1")return;
  const slug=box.dataset.slug,b=box.querySelector("[data-like-button]"),l=box.querySelector("[data-like-label]"),c=box.querySelector("[data-like-count]"),n=box.querySelector("[data-like-newsletter]"),f=box.querySelector("[data-like-form]"),msg=box.querySelector("[data-like-feedback]");if(!slug||!b||!l||!c||!n||!f||!msg)return;box.dataset.bound="1";
  const key=`post-like:${slug}`;let id=localStorage.getItem("blog-like-visitor");if(!id){id=`${Date.now()}-${Math.random().toString(36).slice(2)}-${Math.random().toString(36).slice(2)}`;localStorage.setItem("blog-like-visitor",id)}
  const paint=(num,liked)=>{if(liked){b.classList.add("is-liked");b.setAttribute("aria-pressed","true");l.textContent="Você gostou deste artigo";n.hidden=false}if(num>0){c.textContent=num===1?"1 pessoa gostou deste artigo":`${num} pessoas gostaram deste artigo`;c.hidden=false}};
  const saved=localStorage.getItem(key)==="1";if(saved)paint(0,true);fetch(`/.netlify/functions/likes?slug=${encodeURIComponent(slug)}`).then(r=>r.json()).then(d=>{if(d.status==="ok")paint(Number(d.count)||0,saved)}).catch(()=>{});
  b.addEventListener("click",async()=>{if(localStorage.getItem(key)==="1")return;b.disabled=true;paint(Number(c.textContent.match(/\d+/)?.[0])||0,true);try{const d=await(await fetch("/.netlify/functions/likes",{method:"POST",headers:{"Content-Type":"application/json","Accept":"application/json"},body:JSON.stringify({slug,visitorId:id})})).json();if(d.status==="ok"){localStorage.setItem(key,"1");paint(Number(d.count)||0,true)}}catch{}finally{b.disabled=false}});
  f.addEventListener("submit",async e=>{e.preventDefault();const input=f.querySelector('input[type="email"]'),submit=f.querySelector("button");if(!input||!submit)return;submit.disabled=true;submit.textContent="Enviando...";msg.textContent="";try{const d=await(await fetch("/.netlify/functions/inscrever",{method:"POST",headers:{"Content-Type":"application/x-www-form-urlencoded","Accept":"application/json"},body:`email=${encodeURIComponent(input.value)}&website=${encodeURIComponent(f.querySelector('[name="website"]')?.value||"")}`})).json();if(d.status==="ok"){f.hidden=true;msg.textContent="Pronto. A partir de agora, novas reflexões chegarão até você."}else{msg.textContent="Confira o e-mail e tente novamente.";msg.classList.add("error")}}catch{msg.textContent="Não consegui enviar agora. Tente novamente em instantes.";msg.classList.add("error")}finally{submit.disabled=false;submit.textContent="Quero receber novas reflexões"}})
 }
 if(document.readyState==="loading")document.addEventListener("DOMContentLoaded",bindPostLike,{once:true});else bindPostLike();document.addEventListener("astro:after-swap",bindPostLike);
})();
</script>