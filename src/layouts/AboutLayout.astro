---
import { SITE } from "@config";
import Breadcrumbs from "@components/Breadcrumbs.astro";
import Footer from "@components/Footer.astro";
import Header from "@components/Header.astro";
import Layout from "./Layout.astro";
import ContactCta from "@components/ContactCta.astro";
export interface Props {
  frontmatter: {
    title: string;
    description?: string;
  };
}
const { frontmatter } = Astro.props;
---
<Layout title={`${frontmatter.title} | ${SITE.title}`}>
  <Header activeNav="about" />
  <div class="about-mobile-presence" aria-hidden="true">
    <img src="/hero-salvio.png" alt="" />
    <span><strong>Salvio Gonçalves</strong><small>Terapeuta</small></span>
  </div>
  <Breadcrumbs />
  <main id="main-content">
    <h1 class="about-title">{frontmatter.title}</h1>
    <section class="about-hero">
      <div class="about-photo">
        <img
          src="/hero-salvio.png"
          alt="Salvio Gonçalves, terapeuta"
          loading="eager"
        />
      </div>
      <div class="about-intro">
        <p class="about-greeting">Olá, sou <strong>Salvio Gonçalves</strong>.</p>
        <p>
          Se você chegou até aqui, provavelmente está em busca de algo — e esse
          algo costuma ser mais do que uma resposta. Pode ser um alívio. Um
          recomeço. Ou, simplesmente, alguém que escute de verdade. É para
          isso que este espaço existe.
        </p>
      </div>
    </section>
    <section id="about" class="prose about-body prose-img:border-0">
      <slot />
    </section>
    <section class="about-cta" aria-label="Agende uma conversa">
      <ContactCta />
    </section>
  </main>
  <Footer />
</Layout>
<style>
  #main-content { @apply mx-auto w-full max-w-5xl px-4 pb-12; }
  .about-title { @apply text-2xl font-semibold tracking-wider text-skin-accent sm:text-3xl; }
  .about-hero { @apply mt-8 grid grid-cols-1 items-center gap-8; }
  @media (min-width: 640px) { .about-hero { grid-template-columns: 300px minmax(0, 1fr); } }
  .about-photo img { @apply w-full rounded-2xl border border-skin-line object-cover; }
  .about-intro { @apply self-center text-base leading-relaxed opacity-90 sm:text-lg; }
  .about-greeting { @apply mb-3 text-lg font-semibold text-skin-accent sm:text-xl; }
  .about-body { @apply mt-12 max-w-none; }
  .about-cta { @apply mt-14; }
  /* Presença discreta: aparece somente quando a foto original sai por cima. */
  .about-mobile-presence { position:fixed; top:1rem; left:1rem; z-index:35; display:flex; align-items:center; gap:.8rem; max-width:calc(100% - 2rem); transform:translateY(-180%); border:1px solid rgb(var(--color-line)); border-radius:999px; background:rgb(var(--color-card)/.96); padding:.5rem 1.15rem .5rem .5rem; box-shadow:0 9px 26px rgb(var(--color-base)/.14); backdrop-filter:blur(12px); transition:transform .3s ease; }
  .about-mobile-presence.is-visible { transform:translateY(0); }
  .about-mobile-presence img { width:4rem; height:4rem; flex:0 0 4rem; border:1px solid rgb(var(--color-line)); border-radius:50%; object-fit:cover; }
  .about-mobile-presence span { display:flex; min-width:0; flex-direction:column; line-height:1.15; }
  .about-mobile-presence strong { overflow:hidden; color:rgb(var(--color-accent)); font-size:1rem; text-overflow:ellipsis; white-space:nowrap; }
  .about-mobile-presence small { margin-top:.3rem; color:rgb(var(--color-base)/.68); font-size:.78rem; letter-spacing:.08em; text-transform:uppercase; }
  @media (max-width:639px) {
    .about-mobile-presence { top:.6rem; left:.6rem; gap:.6rem; max-width:calc(100% - 1.2rem); padding:.4rem .9rem .4rem .4rem; }
    .about-mobile-presence img { width:3.25rem; height:3.25rem; flex-basis:3.25rem; }
    .about-mobile-presence strong { font-size:.88rem; }
    .about-mobile-presence small { margin-top:.22rem; font-size:.7rem; }
  }
  @media(prefers-reduced-motion:reduce){.about-mobile-presence{transition:none}}
</style>
<script is:inline>
  function setupAboutMobilePresence(){
    const presence=document.querySelector(".about-mobile-presence");
    const photo=document.querySelector(".about-photo");
    if(!presence||!photo)return;
    const observer=new IntersectionObserver(([entry])=>{
      presence.classList.toggle("is-visible",entry.boundingClientRect.bottom<0&&!entry.isIntersecting);
    },{threshold:0});
    observer.observe(photo);
  }
  setupAboutMobilePresence();
  document.addEventListener("astro:after-swap",setupAboutMobilePresence);
</script>