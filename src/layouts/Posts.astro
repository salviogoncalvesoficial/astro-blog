---
import type { CollectionEntry } from "astro:content";
import Layout from "@layouts/Layout.astro";
import Main from "@layouts/Main.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import Pagination from "@components/Pagination.astro";
import Card from "@components/Card";
import { getCollection } from "astro:content";
import { getFirstImage } from "@utils/getFirstImage";
import getUniqueTags from "@utils/getUniqueTags";
import { slugifyStr } from "@utils/slugify";
import { SITE } from "@config";
export interface Props {
  currentPage: number;
  totalPages: number;
  paginatedPosts: CollectionEntry<"blog">[];
}
const { currentPage, totalPages, paginatedPosts } = Astro.props;
// Temas: todas as tags do blog (não só desta página), para o bloco ser completo
const allPosts = await getCollection("blog");
const temas = getUniqueTags(allPosts);
---
<Layout title={`Artigos | ${SITE.title}`}>
  <Header activeNav="posts" sticky />
  <Main pageTitle="Artigos" pageDesc="Todos os artigos que publiquei.">
    <div class="posts-layout">
      <ul class="posts-grid">
        {
          paginatedPosts.map((post) => (
            <Card
              href={`/posts/${post.slug}/`}
              frontmatter={post.data}
              image={getFirstImage(post.body)}
              className="my-0"
            />
          ))
        }
      </ul>
      {
        temas.length > 0 && (
          <aside class="temas-sidebar" aria-label="Temas do blog">
            <div class="temas-card">
              <h2 class="temas-title">Temas</h2>
              <ul class="temas-list">
                {temas.map(({ tag, tagName }) => (
                  <li>
                    <a href={`/tags/${tag}/`} class="tema-chip">
                      {tagName}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </aside>
        )
      }
    </div>
  </Main>
  <Pagination
    {currentPage}
    {totalPages}
    prevUrl={`/posts${currentPage - 1 !== 1 ? "/" + (currentPage - 1) : ""}/`}
    nextUrl={`/posts/${currentPage + 1}/`}
  />
  <Footer noMarginTop={totalPages > 1} />
</Layout>
<style>
  /* ===== Artigos: 2 colunas de posts + coluna de Temas ===== */
  .posts-layout {
    @apply grid grid-cols-1 gap-8;
  }
  .posts-grid {
    @apply grid grid-cols-1 gap-x-6 gap-y-10;
  }
  @media (min-width: 640px) {
    .posts-grid {
      @apply grid-cols-2;
    }
  }
  @media (min-width: 1024px) {
    .posts-layout {
      grid-template-columns: minmax(0, 1fr) 230px;
    }
    .temas-sidebar {
      @apply self-start;
      position: sticky;
      /* abaixo do header fixo (que tem ~8rem de altura) + respiro */
      top: 10rem;
    }
  }
  /* ===== Bloco de Temas ===== */
  .temas-card {
    @apply rounded-2xl border border-skin-line bg-skin-card p-5;
  }
  .temas-title {
    @apply mb-3 text-center text-sm font-semibold uppercase tracking-wide text-skin-accent;
  }
  .temas-list {
    @apply flex flex-wrap justify-center gap-2;
  }
  .temas-list li {
    @apply m-0;
  }
  .tema-chip {
    @apply inline-block rounded-full border border-skin-line bg-skin-fill px-3 py-1 text-sm text-skin-base transition-colors hover:border-skin-accent hover:text-skin-accent;
  }
</style>