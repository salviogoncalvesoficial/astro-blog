<script>const API="/.netlify/functions/admin",INBOX="/.netlify/functions/inbox";let token=sessionStorage.getItem("nl-admin-token")||"",messages=[],current=null,filter="inbox";const $=id=>document.getElementById(id),esc=s=>String(s??"").replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;","\"":"&quot;","'":"&#39;"}[c]));function notice(id,text,type="ok"){const e=$(id);e.textContent=text;e.className="msg "+type;setTimeout(()=>e.className="msg",5000)}async function call(url,body){return fetch(url,{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({...body,token})}).then(r=>r.json())}function initials(s){const x=String(s||"?").replace(/<.*>/,"").trim().split(/\s+/);return((x[0]?.[0]||"")+(x[1]?.[0]||"")).toUpperCase()||"?"}const gHashes={};async function avatarUpgrade(l){for(const c of l.querySelectorAll(".email-card")){const m=messages.find(x=>x.id===c.dataset.id);if(!m)continue;const em=(((m.from||"").match(/<([^>]+)>/)||[,""])[1]||"").trim().toLowerCase();if(!em||!em.includes("@"))continue;let h=gHashes[em];if(!h){const b=await crypto.subtle.digest("SHA-256",new TextEncoder().encode(em));h=[...new Uint8Array(b)].map(x=>x.toString(16).padStart(2,"0")).join("");gHashes[em]=h}const img=new Image();img.alt="";img.onload=()=>{const av=c.querySelector(".avatar");if(av&&!av.querySelector("img")){av.textContent="";av.style.background="var(--i)";img.style.cssText="width:100%;height:100%;border-radius:50%;object-fit:cover";av.appendChild(img)}};img.src=`https://gravatar.com/avatar/${h}?s=64&d=404`;img.onerror=()=>{const dom=em.split("@")[1];if(!dom)return;const f=new Image();f.alt="";f.onload=()=>{const av=c.querySelector(".avatar");if(av&&!av.querySelector("img")){av.textContent="";av.style.background="var(--i)";f.style.cssText="width:100%;height:100%;border-radius:50%;object-fit:contain;background:#fff";av.appendChild(f)}};f.src=`https://icons.duckduckgo.com/ip3/${dom}.ico`}}}
const archiveSVG='<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="5" rx="1"/><path d="M4 9v9a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9"/><path d="M12 12v5"/><path d="m9.5 14.5 2.5 2.5 2.5-2.5"/></svg>',restoreSVG='<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="5" rx="1"/><path d="M4 9v9a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9"/><path d="M12 17v-5"/><path d="m9.5 12 2.5-2.5L14.5 12"/></svg>';const starSVG=f=>`<svg viewBox="0 0 24 24" width="19" height="19" fill="${f?"#b97a5a":"none"}" stroke="#b97a5a" stroke-width="1.7" stroke-linejoin="round"><path d="M12 2.5l3.05 6.18 6.82.99-4.93 4.81 1.16 6.79L12 18.06l-6.1 3.21 1.16-6.79-4.93-4.81 6.82-.99L12 2.5z"/></svg>`;let selMode=false,selSet=new Set(),lastList=[];const waitBlobs=ms=>new Promise(r=>setTimeout(r,ms));function toggleSel(id){selSet.has(id)?selSet.delete(id):selSet.add(id);renderInbox()}function exitSel(){selMode=false;selSet.clear();$("app").classList.remove("selecting");renderInbox()}function renderBulkBar(){const b=$("bulk-bar");if(!selMode){b.classList.add("hidden");$("app").classList.remove("selecting");return}$("app").classList.add("selecting");b.classList.remove("hidden");$("bulk-count").textContent=selSet.size+" selecionado(s)";$("b-del").classList.toggle("hidden",filter!=="trash");$("b-restore").classList.toggle("hidden",filter!=="trash");$("b-trash").classList.toggle("hidden",filter==="trash");$("b-archive").classList.toggle("hidden",filter==="trash")}function renderInbox(){const q=($("search")||$("search-m")).value.toLowerCase().trim(),list=$("email-list");const base=messages.filter(m=>{if(filter==="unread")return!m.read;if(filter==="favorite")return m.favorite;if(filter==="archive")return m.folder==="archive";if(filter==="sent")return m.folder==="sent";if(filter==="draft")return m.folder==="draft";if(filter==="trash")return m.folder==="trash";return m.folder==="inbox"});const xs=q?base.filter(m=>[m.from,m.subject,m.text,m.html].join(" ").toLowerCase().includes(q)):base;lastList=xs.map(m=>m.id);const titles={inbox:"Cx. Entrada",unread:"Não lidos",favorite:"Favoritos",archive:"Arquivados",sent:"Enviados",draft:"Rascunhos",trash:"Lixeira"};$("inbox-title").textContent=titles[filter]+" ("+base.length+")";$("write").classList.toggle("hidden",filter!=="inbox");list.innerHTML=xs.length?xs.map(m=>{const d=(m.receivedAt||m.sentAt||m.updatedAt)?new Date(m.receivedAt||m.sentAt||m.updatedAt).toLocaleString("pt-BR",{day:"2-digit",month:"2-digit",hour:"2-digit",minute:"2-digit"}):"";const isSent=m.folder==="sent";const fstr=m.from||"";const mm=fstr.match(/^\s*([^<]+?)\s*<([^>]+)>\s*$/);const nm=(mm?mm[1]:fstr.split("@")[0]).replace(/^"|"$/g,"");const isDraft=m.folder==="draft";const dispName=isDraft?"Rascunho — "+(m.to||"(sem destinatário)"):isSent?"Para: "+(m.to||"—"):nm;const em=mm?mm[2]:fstr;return`<div class="email-card ${m.read?"":"unread"} ${isDraft?"draft-card":""}" data-id="${esc(m.id)}"><div class="ec-top">${selMode?`<label class="selck"><input type="checkbox" data-sel="${esc(m.id)}" ${selSet.has(m.id)?"checked":""}></label>`:""}<span class="avatar">${isDraft?"✏️":initials(m.from)}</span><span class="sender"><span class="from">${esc(dispName)}</span>${isSent?"":`<span class="email-addr">${esc(em)}</span>`}${isDraft?`<span class="draft-badge">Rascunho</span>`:""}</span>${isDraft?"":`<button class="star" data-star="${esc(m.id)}" title="${m.favorite?"Remover favorito":"Favoritar"}">${starSVG(m.favorite)}</button>`}</div><div class="ec-mid"><span class="ec-subject">${esc(m.subject)}</span><span class="date">${d}</span></div><div class="ec-preview">${esc(((m.text||(m.html||"").replace(/<[^>]+>/g," ")).replace(/\s+/g," ").trim().slice(0,180)))}</div></div>`}).join(""): `<div class="empty">Nenhuma mensagem nesta visualização.</div>`;list.querySelectorAll(".email-card").forEach(e=>e.onclick=ev=>{if(ev.target.closest(".selck"))return;if(selMode){toggleSel(e.dataset.id)}else{const m=messages.find(x=>x.id===e.dataset.id);if(m&&m.folder==="draft"){openDraft(m.id)}else{openMessage(e.dataset.id)}}});list.querySelectorAll("[data-sel]").forEach(cb=>cb.onchange=()=>{const id=cb.dataset.sel;selSet.has(id)?selSet.delete(id):selSet.add(id);renderBulkBar()});list.querySelectorAll("[data-star]").forEach(b=>b.onclick=async e=>{e.stopPropagation();const m=messages.find(x=>x.id===b.dataset.star);if(m)m.favorite=!m.favorite;renderInbox();await call(INBOX,{action:"set-meta",id:b.dataset.star,value:"favorite"})});avatarUpgrade(list);$("empty-trash").classList.toggle("hidden",filter!=="trash");renderBulkBar()}async function loadInbox(){const r=await call(INBOX,{action:"list"});if(!r.ok)return;messages=r.msgs;$("badge").textContent=r.unread;$("badge").classList.toggle("hidden",!r.unread);renderInbox()}async function refreshSmart(check,tries=5){$("spinner").classList.add("show");try{for(let i=0;i<tries;i++){await loadInbox();if(!check||check(messages))return;await waitBlobs(700)}}finally{$("spinner").classList.remove("show")}}let refreshing=false;async function doRefresh(){if(refreshing)return;refreshing=true;$("spinner").classList.add("show");try{await loadInbox()}finally{$("spinner").classList.remove("show");refreshing=false}}function toastMail(m){const d=document.createElement("div");d.className="mail-toast";const fstr=m.from||"";const mm=fstr.match(/^\s*([^<]+?)\s*<([^>]+)>\s*$/);const nm=(mm?mm[1]:fstr.split("@")[0]).replace(/^"|"$/g,"");d.innerHTML=`<span class="avatar">${initials(m.from)}</span><div class="tt"><div class="tlabel">Novo e-mail</div><b>${esc(nm)}</b><span>${esc(m.subject||"(sem assunto)")}</span></div>`;d.onclick=()=>{d.remove();openMessage(m.id)};document.body.appendChild(d);setTimeout(()=>d.remove(),7000)}let checking=false;async function checkNew(){if(checking||!token||$("app").classList.contains("hidden"))return;checking=true;try{const before=new Set(messages.map(m=>m.id));await loadInbox();const fresh=messages.filter(m=>!before.has(m.id)&&m.folder!=="sent"&&m.folder!=="trash"&&m.folder!=="draft");fresh.slice(0,3).forEach((m,i)=>setTimeout(()=>toastMail(m),i*450))}finally{checking=false}}document.addEventListener("visibilitychange",()=>{if(!document.hidden)checkNew()});setInterval(()=>{if(!document.hidden)checkNew()},60000);if("serviceWorker" in navigator)navigator.serviceWorker.addEventListener("message",e=>{if(e.data&&e.data.type==="new-mail")checkNew()});let pullY=null;document.addEventListener("touchstart",e=>{if(window.scrollY<=0&&!$("app").classList.contains("hidden")&&$("reader").classList.contains("hidden")){pullY=e.touches[0].clientY}},{passive:true});document.addEventListener("touchmove",e=>{if(pullY!==null&&window.scrollY<=0&&e.touches[0].clientY-pullY>80){pullY=null;doRefresh()}},{passive:true});document.addEventListener("touchend",()=>pullY=null);function setFavBtn(){const b=$("fav");b.innerHTML=starSVG(current.favorite);b.title=current.favorite?"Remover favorito":"Favoritar"}async function openMessage(id){const r=await call(INBOX,{action:"read",id});if(!r.ok)return;current=r.msg;$("app").classList.add("reading");$("reader").classList.remove("hidden");$("r-subject").textContent=current.subject;const when=current.receivedAt||current.sentAt;$("r-meta").textContent=current.folder==="sent"?`Para: ${current.to} · ${new Date(when).toLocaleString("pt-BR")}`:`De: ${current.from} · Para: ${current.to||"contato@salviogoncalves.com.br"} · ${new Date(when).toLocaleString("pt-BR")}`;const rb=$("r-body");if(current.html){rb.innerHTML=`<iframe class="mail-frame" sandbox="allow-popups allow-popups-to-escape-sandbox" referrerpolicy="no-referrer" title="Conteúdo do e-mail"></iframe>`;const fr=rb.querySelector("iframe.mail-frame");const darkNow=document.body.classList.contains("dark");fr.srcdoc=darkNow?`<style>html{background:#fff!important;filter:invert(.92) hue-rotate(180deg)}img,video,picture,svg{filter:invert(1) hue-rotate(180deg)}</style>`+current.html:`<style>html,body{background:transparent!important}</style>`+current.html;fr.onload=()=>{try{fr.style.height=Math.max(130,fr.contentDocument.documentElement.scrollHeight+24)+"px"}catch(e){fr.style.height="420px"}}}else{rb.innerHTML=`<div class="mail-plain">${esc(current.text||"(mensagem sem texto)")}</div>`}$("reply-box").classList.add("hidden");$("reply-ok").classList.add("hidden");const rbe=$("rb-editor");if(rbe)rbe.innerHTML="";rbChips=[];renderChips("rb");setFavBtn();const isS=current.folder==="sent";const isT=current.folder==="trash";$("restore-btn").classList.toggle("hidden",!isT);$("reply-toggle").classList.toggle("hidden",isS||isT);$("fav").classList.toggle("hidden",isS);$("archive").classList.toggle("hidden",isS);$("archive").innerHTML=current.folder==="archive"||current.folder==="trash"?restoreSVG:archiveSVG;$("archive").title=current.folder==="archive"||current.folder==="trash"?"Restaurar":"Arquivar";refreshSmart(ms=>{const m=ms.find(x=>x.id===id);return!m||m.read});window.scrollTo({top:0,behavior:"smooth"})}function closeMessage(){$("app").classList.remove("reading");$("reader").classList.add("hidden")}async function loadNews(){const r=await call(API,{action:"list"});if(!r.ok)return;$("active").textContent=r.stats.active;$("new").textContent=r.stats.newThisWeek;$("unsub").textContent=r.stats.unsubscribed;$("total").textContent=r.stats.total;const q=$("sub-search").value.toLowerCase();$("subs").innerHTML=r.subs.filter(s=>s.email.includes(q)).map(s=>`<tr><td>${esc(s.email)}</td><td>${s.status}</td><td>${s.subscribedAt?new Date(s.subscribedAt).toLocaleDateString("pt-BR"):"—"}</td><td><button class="danger" data-del="${esc(s.email)}">remover</button></td></tr>`).join("");const e=await call(API,{action:"emails"});if(e.ok)$("sent").innerHTML=e.emails.map(x=>`<tr><td>${new Date(x.created_at).toLocaleString("pt-BR")}</td><td>${esc(x.to)}</td><td>${esc(x.subject)}</td><td>${esc(x.last_event)}</td></tr>`).join("")}function enter(t){token=t;sessionStorage.setItem("nl-admin-token",t);$("login").classList.add("hidden");$("app").classList.remove("hidden");loadInbox();loadNews();loadPosts()}const sunSVG="",moonSVG="";function applyTheme(dark){document.body.classList.toggle("dark",dark)}function logout(){token="";sessionStorage.removeItem("nl-admin-token");location.reload()}$("login-form").onsubmit=async e=>{e.preventDefault();const r=await fetch(API,{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({action:"login",password:$("password").value})}).then(x=>x.json());r.ok?enter(r.token):notice("login-msg",r.error,"err")};$("logout").onclick=logout;$("refresh").onclick=doRefresh;document.querySelectorAll(".tab").forEach(b=>b.onclick=()=>{document.querySelectorAll(".tab").forEach(x=>x.classList.remove("active"));b.classList.add("active");$("inbox-tab").classList.toggle("hidden",b.dataset.tab!=="inbox");$("news-tab").classList.toggle("hidden",b.dataset.tab!=="news");$("blog-tab").classList.toggle("hidden",b.dataset.tab!=="blog");if(b.dataset.tab==="news")loadNews();if(b.dataset.tab==="blog")loadPosts()});const POSTS="/.netlify/functions/posts";let posts=[];function renderPosts(){const q=$("post-search").value.toLowerCase().trim();const xs=posts.filter(p=>!q||[p.title,p.tags.join(" ")].join(" ").toLowerCase().includes(q));$("post-list").innerHTML=xs.length?xs.map(p=>`<div class="post-card" data-file="${esc(p.file)}"><div class="post-top"><span class="post-title">${esc(p.title)}</span>${p.draft?'<span class="pill draft">Rascunho</span>':""}${p.featured?'<span class="pill feat">★ Destaque</span>':""}</div><div class="post-meta"><span>${p.pubDatetime||""}</span>${p.tags.map(t=>`<span class="tagchip">${esc(t)}</span>`).join("")}</div></div>`).join(""):"<div class=\"empty\">Nenhum post encontrado.</div>"};async function loadPosts(){const r=await call(POSTS,{action:"list"});if(r.ok){posts=r.posts;renderPosts()}}if(token){enter(token)}</script></body></html>