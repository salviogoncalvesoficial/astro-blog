<!doctype html><html lang="pt-br"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><meta name="robots" content="noindex,nofollow"/><title>Admin · Sálvio Gonçalves</title><style>
:root{--i:#faf7f2;--s:#f1ebe2;--l:#e2dacd;--t:#2c2723;--m:#6e655c;--g:#4e6351;--r:#b3474d;--w:#fff;--terra:#b97a5a}*{box-sizing:border-box}body{margin:0;background:var(--s);color:var(--t);font-family:Georgia,serif;padding:26px 14px}.shell{max-width:980px;margin:auto}.card{background:var(--i);border:1px solid var(--l);border-radius:18px;padding:24px;margin-bottom:18px}h1{margin:0 0 4px;color:var(--g);font-size:24px}h2{margin:0 0 14px;color:var(--g);font-size:14px;letter-spacing:.14em;text-transform:uppercase}.sub{color:var(--m);font-size:13px;margin:0 0 18px}input,textarea,button{font:inherit;font-size:14px;border:1px solid var(--l);background:var(--w);color:var(--t);padding:11px 16px;border-radius:999px}input,textarea{min-width:0}textarea{width:100%;border-radius:13px;resize:vertical}input:focus,textarea:focus{outline:2px solid #4e635133;border-color:var(--g)}button{background:var(--g);border-color:var(--g);color:var(--i);font-weight:600;cursor:pointer}button:hover{opacity:.9}.outline{background:transparent;color:var(--g)}.danger{background:transparent;border-color:var(--r);color:var(--r);font-size:12px}.terra{background:transparent;border-color:var(--terra);color:var(--terra)}.terra.on{background:var(--terra);border-color:var(--terra);color:#fff}.hidden{display:none!important}.row,.toolbar,.actions{display:flex;gap:9px;align-items:center;flex-wrap:wrap}.search{flex:1;min-width:220px}.msg{display:none;margin-top:12px;padding:10px 14px;border-radius:10px;font-size:13px}.msg.ok{display:block;background:#e5efe6;color:var(--g)}.msg.err{display:block;background:#f3e3e4;color:var(--r)}.tabs{display:flex;gap:8px;margin-bottom:18px;flex-wrap:wrap}.tab{background:var(--i);border-color:var(--l);color:var(--m)}.tab.active{background:var(--g);border-color:var(--g);color:var(--i)}.badge{font-size:11px;background:var(--r);color:white;padding:2px 7px;border-radius:99px;margin-left:5px}.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:10px}.stat{background:var(--s);border-radius:13px;text-align:center;padding:14px}.stat b{font-size:25px;color:var(--g);display:block}.stat span{font-size:12px;color:var(--m)}
/* --- Lista: cartões em caixa --- */
.email-list{display:grid;gap:12px}.email-card{background:var(--w);border:1px solid var(--l);border-radius:14px;padding:16px 18px;cursor:pointer;transition:box-shadow .15s,border-color .15s}.email-card:hover{border-color:var(--g);box-shadow:0 3px 14px rgba(44,39,35,.08)}.email-card.unread{background:#f8fbf8;border-left:4px solid var(--g)}.ec-top{display:flex;align-items:center;gap:10px;margin-bottom:8px}.avatar{width:32px;height:32px;border-radius:50%;background:var(--g);color:var(--i);display:grid;place-items:center;font-size:13px;flex-shrink:0}.ec-top .from{flex:1;font-size:13px;color:var(--m);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.email-card.unread .ec-top .from{color:var(--t);font-weight:700}.date{font-size:12px;color:var(--m);white-space:nowrap;flex-shrink:0}.star{border:0;background:transparent;padding:2px;line-height:1;cursor:pointer;display:grid;place-items:center}.ec-subject{font-size:16px;font-weight:700;color:var(--g);margin:0 0 5px;line-height:1.35}.ec-preview{font-size:13px;color:var(--m);line-height:1.55;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}.empty{text-align:center;color:var(--m);padding:28px}
/* --- Modo leitura: esconde abas e lista --- */
#app.reading .tabs,#app.reading #list-card{display:none}
.reader-head{display:flex;justify-content:space-between;gap:12px;align-items:flex-start}.reader-meta{color:var(--m);font-size:13px;margin:5px 0 18px}.reader-body{background:var(--s);border-radius:13px;padding:22px;line-height:1.75;white-space:pre-wrap;word-break:break-word;min-height:130px;font-size:15px}.reply{margin-top:16px}.table-wrap{overflow:auto}table{width:100%;border-collapse:collapse;font-size:13px}th{text-align:left;color:var(--m);padding:8px;border-bottom:1px solid var(--l)}td{padding:9px 8px;border-bottom:1px solid var(--s)}.pill{font-size:11px;border-radius:99px;padding:3px 9px;background:#e5efe6;color:var(--g)}
@media(max-width:680px){body{padding:14px 9px}.card{padding:18px}.stats{grid-template-columns:repeat(2,1fr)}.row input{width:100%}.reader-body{padding:16px}}
</style></head><body><div class="shell">
<div class="card" id="login"><h1>Admin · Sálvio Gonçalves</h1><p class="sub">Newsletter e caixa de entrada</p><form id="login-form" class="row"><input id="password" type="password" placeholder="Senha do admin"/><button>Entrar</button></form><p id="login-msg" class="msg"></p></div>
<div id="app" class="hidden"><div class="tabs"><button class="tab active" data-tab="inbox">Caixa de entrada <span id="badge" class="badge hidden">0</span></button><button class="tab" data-tab="news">Newsletter</button><button id="logout" class="danger">Sair</button></div>
<section id="inbox-tab"><div class="card" id="list-card"><div class="reader-head"><div><h1>Caixa de entrada</h1><p class="sub">Mensagens recebidas em @salviogoncalves.com.br</p></div><button id="refresh" class="outline">Atualizar</button></div><div class="toolbar"><input id="search" class="search" placeholder="⌕ Buscar por remetente, assunto ou conteúdo..."/><button class="filter" data-filter="inbox">Todos</button><button class="filter" data-filter="unread">Não lidos</button><button class="filter" data-filter="favorite">Favoritos</button><button class="filter" data-filter="archive">Arquivados</button></div><div id="email-list" class="email-list"></div></div><div id="reader" class="card hidden"><div class="reader-head"><div><h2 id="r-subject">Mensagem</h2><p id="r-meta" class="reader-meta"></p></div><button id="close" class="outline">← Voltar</button></div><div id="r-body" class="reader-body"></div><div class="actions"><button id="reply-toggle">Responder</button><button id="fav" class="terra">Favoritar</button><button id="archive" class="outline">Arquivar</button><button id="delete" class="danger">Apagar</button></div><div id="reply-box" class="reply hidden"><textarea id="reply-text" rows="7" placeholder="Escreva sua resposta..."></textarea><div class="actions"><button id="send-reply">Enviar resposta</button></div></div><p id="inbox-msg" class="msg"></p></div></section>
<section id="news-tab" class="hidden"><div class="card"><h1>Newsletter · painel</h1><p class="sub">Lista e envios automáticos</p><div class="stats"><div class="stat"><b id="active">–</b><span>ativos</span></div><div class="stat"><b id="new">–</b><span>novos (7 dias)</span></div><div class="stat"><b id="unsub">–</b><span>cancelados</span></div><div class="stat"><b id="total">–</b><span>total</span></div></div><div class="actions" style="margin-top:16px"><button id="send-news">Enviar newsletter agora</button><button id="export" class="outline">Exportar CSV</button></div><p id="news-msg" class="msg"></p></div><div class="card"><h2>Inscritos</h2><div class="toolbar"><input id="sub-search" class="search" placeholder="Buscar e-mail..."/><button id="add-toggle" class="outline">+ Adicionar</button></div><div id="add-row" class="row hidden"><input id="new-email" type="email" placeholder="novo@email.com"/><button id="add">Adicionar</button></div><div class="table-wrap"><table><thead><tr><th>E-mail</th><th>Status</th><th>Data</th><th></th></tr></thead><tbody id="subs"></tbody></table></div></div><div class="card"><h2>Últimos envios</h2><div class="table-wrap"><table><thead><tr><th>Data</th><th>Para</th><th>Assunto</th><th>Status</th></tr></thead><tbody id="sent"></tbody></table></div></div></section></div></div>
<script>
const API="/.netlify/functions/admin",INBOX="/.netlify/functions/inbox";let token=sessionStorage.getItem("nl-admin-token")||"",messages=[],current=null,filter="inbox";const $=id=>document.getElementById(id);const esc=s=>String(s??"").replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;","\"":"&quot;","'":"&#39;"}[c]));function notice(id,text,type="ok"){const e=$(id);e.textContent=text;e.className="msg "+type;setTimeout(()=>e.className="msg",5000)}async function call(url,body){return fetch(url,{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({...body,token})}).then(r=>r.json())}function initials(s){const x=String(s||"?").replace(/<.*>/,"").trim().split(/\s+/);return((x[0]?.[0]||"")+(x[1]?.[0]||"")).toUpperCase()||"?"}
const starSVG=f=>`<svg viewBox="0 0 24 24" width="19" height="19" fill="${f?"#b97a5a":"none"}" stroke="#b97a5a" stroke-width="1.7" stroke-linejoin="round"><path d="M12 2.5l3.05 6.18 6.82.99-4.93 4.81 1.16 6.79L12 18.06l-6.1 3.21 1.16-6.79-4.93-4.81 6.82-.99L12 2.5z"/></svg>`;
function renderInbox(){const q=$("search").value.toLowerCase().trim(),list=$("email-list");let xs=messages.filter(m=>{const hay=[m.from,m.subject,m.text].join(" ").toLowerCase();if(q&&!hay.includes(q))return false;if(filter==="unread")return!m.read;if(filter==="favorite")return m.favorite;if(filter==="archive")return m.folder==="archive";return m.folder!=="archive"&&m.folder!=="trash"});list.innerHTML=xs.length?xs.map(m=>{const d=m.receivedAt?new Date(m.receivedAt).toLocaleString("pt-BR",{day:"2-digit",month:"2-digit",hour:"2-digit",minute:"2-digit"}):"";return`<div class="email-card ${m.read?"":"unread"}" data-id="${esc(m.id)}"><div class="ec-top"><span class="avatar">${initials(m.from)}</span><span class="from">${esc(m.from)}</span><span class="date">${d}</span><button class="star" data-star="${esc(m.id)}" title="${m.favorite?"Remover favorito":"Favoritar"}">${starSVG(m.favorite)}</button></div><div class="ec-subject">${esc(m.subject)}</div><div class="ec-preview">${esc((m.text||"").replace(/\s+/g," ").trim().slice(0,180))}</div></div>`}).join(""):`<div class="empty">Nenhuma mensagem nesta visualização.</div>`;list.querySelectorAll(".email-card").forEach(e=>e.onclick=()=>openMessage(e.dataset.id));list.querySelectorAll("[data-star]").forEach(b=>b.onclick=async e=>{e.stopPropagation();await call(INBOX,{action:"set-meta",id:b.dataset.star,value:"favorite"});loadInbox()})}
async function loadInbox(){const r=await call(INBOX,{action:"list"});if(!r.ok)return;messages=r.msgs;$("badge").textContent=r.unread;$("badge").classList.toggle("hidden",!r.unread);renderInbox()}
function setFavBtn(){const b=$("fav");b.classList.toggle("on",!!current.favorite);b.innerHTML=current.favorite?"★ Favoritado":"☆ Favoritar"}
async function openMessage(id){const r=await call(INBOX,{action:"read",id});if(!r.ok)return;current=r.msg;$("app").classList.add("reading");$("reader").classList.remove("hidden");$("r-subject").textContent=current.subject;$("r-meta").textContent=`De: ${current.from} · Para: ${current.to||"contato@salviogoncalves.com.br"} · ${new Date(current.receivedAt).toLocaleString("pt-BR")}`;$("r-body").textContent=current.text||"(mensagem sem texto)";$("reply-box").classList.add("hidden");setFavBtn();loadInbox();window.scrollTo({top:0,behavior:"smooth"})}
function closeMessage(){$("app").classList.remove("reading");$("reader").classList.add("hidden")}
async function loadNews(){const r=await call(API,{action:"list"});if(!r.ok)return;$("active").textContent=r.stats.active;$("new").textContent=r.stats.newThisWeek;$("unsub").textContent=r.stats.unsubscribed;$("total").textContent=r.stats.total;const q=$("sub-search").value.toLowerCase();$("subs").innerHTML=r.subs.filter(s=>s.email.includes(q)).map(s=>`<tr><td>${esc(s.email)}</td><td>${s.status}</td><td>${s.subscribedAt?new Date(s.subscribedAt).toLocaleDateString("pt-BR"):"—"}</td><td><button class="danger" data-del="${esc(s.email)}">remover</button></td></tr>`).join("");$("subs").querySelectorAll("[data-del]").forEach(b=>b.onclick=async()=>{if(confirm("Remover este inscrito?")){await call(API,{action:"delete",email:b.dataset.del});loadNews()}});const e=await call(API,{action:"emails"});if(e.ok)$("sent").innerHTML=e.emails.map(x=>`<tr><td>${new Date(x.created_at).toLocaleString("pt-BR")}</td><td>${esc(x.to)}</td><td>${esc(x.subject)}</td><td>${esc(x.last_event)}</td></tr>`).join("")}
function enter(t){token=t;sessionStorage.setItem("nl-admin-token",t);$("login").classList.add("hidden");$("app").classList.remove("hidden");loadInbox();loadNews()}function logout(){token="";sessionStorage.removeItem("nl-admin-token");location.reload()}$("login-form").onsubmit=async e=>{e.preventDefault();const r=await fetch(API,{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({action:"login",password:$("password").value})}).then(x=>x.json());r.ok?enter(r.token):notice("login-msg",r.error,"err")};$("logout").onclick=logout;$("refresh").onclick=loadInbox;$("search").oninput=renderInbox;$("close").onclick=closeMessage;document.querySelectorAll(".filter").forEach(b=>b.onclick=()=>{document.querySelectorAll(".filter").forEach(x=>x.classList.remove("active-filter"));b.classList.add("active-filter");filter=b.dataset.filter;renderInbox()});$("reply-toggle").onclick=()=>$("reply-box").classList.toggle("hidden");$("fav").onclick=async()=>{await call(INBOX,{action:"set-meta",id:current.id,value:"favorite"});current.favorite=!current.favorite;setFavBtn();loadInbox()};$("send-reply").onclick=async()=>{const text=$("reply-text").value.trim();if(!text)return;$("send-reply").disabled=true;const to=(current.from.match(/<([^>]+)>/)||[,current.from])[1];const r=await call(INBOX,{action:"reply",to,subject:"Re: "+current.subject,text});$("send-reply").disabled=false;r.ok?($("reply-text").value="",notice("inbox-msg","Resposta enviada!")):notice("inbox-msg",r.error,"err")};$("archive").onclick=async()=>{await call(INBOX,{action:"set-meta",id:current.id,value:"archive"});closeMessage();loadInbox()};$("delete").onclick=async()=>{if(confirm("Apagar esta mensagem?")){await call(INBOX,{action:"set-meta",id:current.id,value:"trash"});closeMessage();loadInbox()}};document.querySelectorAll(".tab").forEach(b=>b.onclick=()=>{document.querySelectorAll(".tab").forEach(x=>x.classList.remove("active"));b.classList.add("active");$("inbox-tab").classList.toggle("hidden",b.dataset.tab!=="inbox");$("news-tab").classList.toggle("hidden",b.dataset.tab!=="news");if(b.dataset.tab==="news")loadNews()});$("sub-search").oninput=loadNews;$("add-toggle").onclick=()=>$("add-row").classList.toggle("hidden");$("add").onclick=async()=>{await call(API,{action:"add",email:$("new-email").value});$("new-email").value="";loadNews()};$("send-news").onclick=async()=>{if(confirm("Enviar newsletter agora?")){const r=await call(API,{action:"send"});notice("news-msg",r.message||r.error,r.ok?"ok":"err")}};$("export").onclick=()=>window.open(`${API}?token=${encodeURIComponent(token)}&export=1`);if(token)enter(token);
</script></body></html>