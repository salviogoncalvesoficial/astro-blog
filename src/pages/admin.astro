---
// ============================================================
// /admin — Dashboard da newsletter + Caixa de entrada (Etapa 2)
// Página invisível: fora do menu, do sitemap e bloqueada no robots.txt.
// Acesso: salviogoncalves.com.br/admin/ + senha (variável ADMIN_PASSWORD)
// ============================================================
---
<!doctype html>
<html lang="pt-br">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Admin · Salvio Gonçalves</title>
    <style>
      :root {
        --marfim: #faf7f2;
        --areia: #f1ebe2;
        --bege: #e2dacd;
        --texto: #2c2723;
        --cinza: #6e655c;
        --salvia: #4e6351;
        --vermelho: #b3474d;
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        background: var(--areia);
        font-family: Georgia, "Times New Roman", serif;
        color: var(--texto);
        min-height: 100vh;
        padding: 32px 16px;
      }
      .wrap { max-width: 900px; margin: 0 auto; }
      .card {
        background: var(--marfim);
        border: 1px solid var(--bege);
        border-radius: 16px;
        padding: 28px;
        margin-bottom: 20px;
      }
      h1 { font-size: 22px; margin: 0 0 4px 0; color: var(--salvia); }
      .sub { color: var(--cinza); font-size: 13px; margin: 0 0 20px 0; }
      h2 { font-size: 15px; text-transform: uppercase; letter-spacing: 0.15em; color: var(--salvia); margin: 0 0 14px 0; }
      input, button, textarea, select {
        font-family: inherit;
        font-size: 14px;
        border-radius: 999px;
        padding: 10px 18px;
        border: 1px solid var(--bege);
        background: #fff;
        color: var(--texto);
      }
      input, textarea { flex: 1; min-width: 0; }
      textarea { border-radius: 12px; width: 100%; resize: vertical; }
      input:focus, textarea:focus { outline: none; border-color: var(--salvia); }
      button {
        background: var(--salvia);
        color: var(--marfim);
        border: none;
        cursor: pointer;
        font-weight: 600;
      }
      button:hover { opacity: 0.9; }
      button.secundario { background: transparent; color: var(--salvia); border: 1px solid var(--salvia); }
      button.perigo { background: transparent; color: var(--vermelho); border: 1px solid var(--vermelho); padding: 6px 12px; font-size: 12px; }
      .linha { display: flex; gap: 10px; align-items: center; }
      .stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 12px; }
      .stat { background: var(--areia); border-radius: 12px; padding: 16px; text-align: center; }
      .stat b { display: block; font-size: 26px; color: var(--salvia); }
      .stat span { font-size: 12px; color: var(--cinza); }
      table { width: 100%; border-collapse: collapse; font-size: 13px; }
      th { text-align: left; color: var(--cinza); font-weight: 600; padding: 8px 6px; border-bottom: 1px solid var(--bege); }
      td { padding: 8px 6px; border-bottom: 1px solid var(--areia); }
      .tag { font-size: 11px; padding: 2px 10px; border-radius: 999px; }
      .tag.ativo { background: #e5efe6; color: var(--salvia); }
      .tag.cancelado { background: #f3e3e4; color: var(--vermelho); }
      .tag.naolido { background: var(--salvia); color: var(--marfim); }
      .msg { margin-top: 12px; font-size: 13px; padding: 10px 14px; border-radius: 10px; display: none; }
      .msg.ok { display: block; background: #e5efe6; color: var(--salvia); }
      .msg.err { display: block; background: #f3e3e4; color: var(--vermelho); }
      .acoes { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 14px; }
      .busca { margin-bottom: 12px; }
      .escondido { display: none; }
      .data { color: var(--cinza); font-size: 12px; }
      /* ===== abas ===== */
      .abas { display: flex; gap: 8px; margin-bottom: 20px; }
      .aba {
        background: var(--marfim); border: 1px solid var(--bege); color: var(--cinza);
        border-radius: 999px; padding: 10px 20px; cursor: pointer; font-family: inherit; font-size: 14px;
      }
      .aba.ativa { background: var(--salvia); color: var(--marfim); border-color: var(--salvia); }
      .badge { background: var(--vermelho); color: #fff; border-radius: 999px; font-size: 11px; padding: 1px 7px; margin-left: 6px; }
      /* ===== leitor de e-mail ===== */
      .email-item { padding: 12px 8px; border-bottom: 1px solid var(--areia); cursor: pointer; display: flex; gap: 10px; align-items: center; }
      .email-item:hover { background: var(--areia); border-radius: 8px; }
      .email-item.nao-lido { font-weight: 700; }
      .email-item .de { min-width: 180px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
      .email-item .assunto { flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
      #leitor .corpo { background: var(--areia); border-radius: 12px; padding: 16px; white-space: pre-wrap; word-break: break-word; font-size: 14px; line-height: 1.6; }
    </style>
  </head>
  <body>
    <div class="wrap">
      <!-- ===== Login ===== -->
      <div class="card" id="tela-login">
        <h1>Admin · Salvio Gonçalves</h1>
        <p class="sub">Área privada — newsletter e caixa de entrada</p>
        <form class="linha" id="form-login">
          <input type="password" id="senha" placeholder="Senha do admin" autocomplete="current-password" />
          <button type="submit">Entrar</button>
        </form>
        <p class="msg" id="msg-login"></p>
      </div>

      <!-- ===== Dashboard ===== -->
      <div id="dashboard" class="escondido">
        <div class="abas">
          <button class="aba ativa" data-aba="newsletter">Newsletter</button>
          <button class="aba" data-aba="inbox">Caixa de entrada<span class="badge escondido" id="badge-inbox">0</span></button>
        </div>

        <!-- ===== ABA NEWSLETTER ===== -->
        <div id="aba-newsletter">
          <div class="card">
            <h1>Newsletter · painel</h1>
            <p class="sub">salviogoncalves.com.br — sistema próprio (Netlify + Resend)</p>
            <div class="stats">
              <div class="stat"><b id="st-ativos">–</b><span>ativos</span></div>
              <div class="stat"><b id="st-novos">–</b><span>novos (7 dias)</span></div>
              <div class="stat"><b id="st-cancelados">–</b><span>cancelados</span></div>
              <div class="stat"><b id="st-total">–</b><span>total</span></div>
            </div>
            <div class="acoes">
              <button class="secundario" id="btn-enviar">Enviar newsletter agora</button>
              <button class="secundario" id="btn-csv">Exportar lista (CSV)</button>
              <button class="perigo" id="btn-sair">Sair</button>
            </div>
            <p class="msg" id="msg-painel"></p>
          </div>

          <div class="card">
            <h2>Inscritos</h2>
            <div class="linha busca">
              <input type="text" id="busca" placeholder="Buscar e-mail..." />
              <button class="secundario" id="btn-add-toggle">+ Adicionar</button>
            </div>
            <div class="linha escondido" id="linha-add" style="margin-bottom: 12px;">
              <input type="email" id="novo-email" placeholder="novo@email.com" />
              <button id="btn-add">Adicionar</button>
            </div>
            <div style="overflow-x: auto;">
              <table>
                <thead>
                  <tr><th>E-mail</th><th>Status</th><th>Inscrito em</th><th></th></tr>
                </thead>
                <tbody id="tbody"></tbody>
              </table>
            </div>
          </div>

          <div class="card">
            <h2>Últimos envios</h2>
            <div style="overflow-x: auto;">
              <table>
                <thead>
                  <tr><th>Data</th><th>Para</th><th>Assunto</th><th>Status</th></tr>
                </thead>
                <tbody id="tbody-emails"></tbody>
              </table>
            </div>
          </div>
        </div>

        <!-- ===== ABA CAIXA DE ENTRADA ===== -->
        <div id="aba-inbox" class="escondido">
          <div class="card">
            <h1>Caixa de entrada</h1>
            <p class="sub">E-mails recebidos em @salviogoncalves.com.br (via Resend)</p>
            <div class="acoes" style="margin: 0 0 14px 0;">
              <button class="secundario" id="btn-inbox-refresh">Atualizar</button>
              <button class="perigo" id="btn-sair2">Sair</button>
            </div>
            <div id="lista-emails"></div>
          </div>

          <div class="card escondido" id="leitor">
            <h2 id="leitor-assunto"></h2>
            <p class="sub" id="leitor-de"></p>
            <div class="corpo" id="leitor-corpo"></div>
            <details style="margin-top: 14px;">
              <summary style="cursor: pointer; color: var(--salvia); font-weight: 600;">Responder</summary>
              <div style="margin-top: 12px;">
                <textarea id="resposta-texto" rows="6" placeholder="Escreva sua resposta..."></textarea>
                <div class="acoes">
                  <button id="btn-responder">Enviar resposta</button>
                </div>
              </div>
            </details>
            <div class="acoes">
              <button class="perigo" id="btn-apagar-email">Apagar mensagem</button>
              <button class="secundario" id="btn-fechar-leitor">Fechar</button>
            </div>
            <p class="msg" id="msg-inbox"></p>
          </div>
        </div>
      </div>
    </div>

    <script>
      const API = "/.netlify/functions/admin";
      const INBOX_API = "/.netlify/functions/inbox";
      let TOKEN = sessionStorage.getItem("nl-admin-token") || "";
      let SUBS = [];
      let EMAIL_ATUAL = null;

      const $ = (id) => document.getElementById(id);

      function msg(id, texto, tipo) {
        const el = $(id);
        el.textContent = texto;
        el.className = "msg " + (tipo || "ok");
        setTimeout(() => { el.className = "msg"; }, 5000);
      }

      async function api(body) {
        const res = await fetch(API, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ ...body, token: TOKEN }),
        });
        return res.json();
      }

      async function apiInbox(body) {
        const res = await fetch(INBOX_API, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ ...body, token: TOKEN }),
        });
        return res.json();
      }

      /* ================= NEWSLETTER ================= */

      function renderTabela() {
        const filtro = $("busca").value.toLowerCase().trim();
        const tbody = $("tbody");
        tbody.innerHTML = "";
        SUBS.filter((s) => s.email.includes(filtro)).forEach((s) => {
          const tr = document.createElement("tr");
          const data = s.subscribedAt ? new Date(s.subscribedAt).toLocaleDateString("pt-BR") : "—";
          tr.innerHTML = `
            <td>${s.email}</td>
            <td><span class="tag ${s.status === "active" ? "ativo" : "cancelado"}">${s.status === "active" ? "ativo" : "cancelado"}</span></td>
            <td class="data">${data}</td>
            <td><button class="perigo" data-email="${s.email}">remover</button></td>`;
          tbody.appendChild(tr);
        });
        tbody.querySelectorAll("button.perigo").forEach((btn) => {
          btn.addEventListener("click", async () => {
            if (!confirm(`Remover ${btn.dataset.email} da lista?`)) return;
            const r = await api({ action: "delete", email: btn.dataset.email });
            if (r.ok) { msg("msg-painel", "Removido."); carregar(); }
          });
        });
      }

      function renderEmails(emails) {
        const tbody = $("tbody-emails");
        tbody.innerHTML = "";
        (emails || []).forEach((e) => {
          const tr = document.createElement("tr");
          const data = e.created_at ? new Date(e.created_at).toLocaleString("pt-BR", { day: "2-digit", month: "2-digit", hour: "2-digit", minute: "2-digit" }) : "—";
          const cor = e.last_event === "delivered" || e.last_event === "opened" ? "ativo" : "cancelado";
          tr.innerHTML = `
            <td class="data">${data}</td>
            <td>${e.to || "—"}</td>
            <td>${e.subject || "—"}</td>
            <td><span class="tag ${cor}">${e.last_event || "—"}</span></td>`;
          tbody.appendChild(tr);
        });
      }

      async function carregar() {
        const r = await api({ action: "list" });
        if (!r.ok) { sair(); return; }
        SUBS = r.subs;
        $("st-ativos").textContent = r.stats.active;
        $("st-novos").textContent = r.stats.newThisWeek;
        $("st-cancelados").textContent = r.stats.unsubscribed;
        $("st-total").textContent = r.stats.total;
        renderTabela();
        const re = await api({ action: "emails" });
        if (re.ok) renderEmails(re.emails);
      }

      /* ================= INBOX ================= */

      async function carregarInbox() {
        const r = await apiInbox({ action: "list" });
        if (!r.ok) return;
        const lista = $("lista-emails");
        lista.innerHTML = "";
        const badge = $("badge-inbox");
        if (r.unread > 0) { badge.textContent = r.unread; badge.classList.remove("escondido"); }
        else badge.classList.add("escondido");

        if (r.msgs.length === 0) {
          lista.innerHTML = '<p class="sub">Nenhuma mensagem recebida ainda. Quando alguém escrever para contato@salviogoncalves.com.br, aparece aqui.</p>';
          return;
        }
        r.msgs.forEach((m) => {
          const div = document.createElement("div");
          div.className = "email-item" + (m.read ? "" : " nao-lido");
          const data = m.receivedAt ? new Date(m.receivedAt).toLocaleString("pt-BR", { day: "2-digit", month: "2-digit", hour: "2-digit", minute: "2-digit" }) : "";
          div.innerHTML = `
            <span class="de">${m.from}</span>
            <span class="assunto">${m.subject}</span>
            <span class="data">${data}</span>
            ${m.read ? "" : '<span class="tag naolido">novo</span>'}`;
          div.addEventListener("click", () => abrirEmail(m.id));
          lista.appendChild(div);
        });
      }

      async function abrirEmail(id) {
        const r = await apiInbox({ action: "read", id });
        if (!r.ok) return;
        EMAIL_ATUAL = r.msg;
        $("leitor").classList.remove("escondido");
        $("leitor-assunto").textContent = r.msg.subject;
        $("leitor-de").textContent = `De: ${r.msg.from}`;
        $("leitor-corpo").textContent = r.msg.text || r.msg.html || "(mensagem vazia)";
        carregarInbox();
      }

      /* ================= eventos ================= */

      // abas
      document.querySelectorAll(".aba").forEach((aba) => {
        aba.addEventListener("click", () => {
          document.querySelectorAll(".aba").forEach((a) => a.classList.remove("ativa"));
          aba.classList.add("ativa");
          $("aba-newsletter").classList.toggle("escondido", aba.dataset.aba !== "newsletter");
          $("aba-inbox").classList.toggle("escondido", aba.dataset.aba !== "inbox");
          if (aba.dataset.aba === "inbox") carregarInbox();
        });
      });

      $("form-login").addEventListener("submit", async (e) => {
        e.preventDefault();
        const res = await fetch(API, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ action: "login", password: $("senha").value }),
        });
        const r = await res.json();
        if (r.ok) entrar(r.token);
        else msg("msg-login", r.error || "Erro", "err");
        $("senha").value = "";
      });

      $("busca").addEventListener("input", renderTabela);
      $("btn-add-toggle").addEventListener("click", () => $("linha-add").classList.toggle("escondido"));

      $("btn-add").addEventListener("click", async () => {
        const email = $("novo-email").value;
        const r = await api({ action: "add", email });
        if (r.ok) { $("novo-email").value = ""; msg("msg-painel", "Adicionado à lista."); carregar(); }
        else msg("msg-painel", r.error || "Erro", "err");
      });

      $("btn-enviar").addEventListener("click", async () => {
        if (!confirm("Enviar a newsletter agora para todos os ativos?")) return;
        $("btn-enviar").disabled = true;
        $("btn-enviar").textContent = "Enviando...";
        const r = await api({ action: "send" });
        $("btn-enviar").disabled = false;
        $("btn-enviar").textContent = "Enviar newsletter agora";
        msg("msg-painel", r.message || r.error || "Concluído", "ok");
      });

      $("btn-csv").addEventListener("click", () => {
        window.open(`${API}?token=${encodeURIComponent(TOKEN)}&export=1`, "_blank");
      });

      $("btn-inbox-refresh").addEventListener("click", carregarInbox);

      $("btn-fechar-leitor").addEventListener("click", () => $("leitor").classList.add("escondido"));

      $("btn-apagar-email").addEventListener("click", async () => {
        if (!EMAIL_ATUAL || !confirm("Apagar esta mensagem?")) return;
        const r = await apiInbox({ action: "delete", id: EMAIL_ATUAL.id });
        if (r.ok) {
          $("leitor").classList.add("escondido");
          msg("msg-inbox", "Mensagem apagada.", "ok");
          carregarInbox();
        }
      });

      $("btn-responder").addEventListener("click", async () => {
        const texto = $("resposta-texto").value;
        if (!texto.trim()) return;
        $("btn-responder").disabled = true;
        const r = await apiInbox({
          action: "reply",
          to: EMAIL_ATUAL.from.replace(/^.*</, "").replace(/>$/, "").trim(),
          subject: "Re: " + EMAIL_ATUAL.subject,
          text,
        });
        $("btn-responder").disabled = false;
        if (r.ok) {
          $("resposta-texto").value = "";
          msg("msg-inbox", "Resposta enviada!", "ok");
        } else {
          msg("msg-inbox", r.error || "Erro ao enviar", "err");
        }
      });

      function sair() {
        TOKEN = "";
        sessionStorage.removeItem("nl-admin-token");
        $("dashboard").classList.add("escondido");
        $("tela-login").classList.remove("escondido");
      }
      $("btn-sair").addEventListener("click", sair);
      $("btn-sair2").addEventListener("click", sair);

      function entrar(token) {
        TOKEN = token;
        sessionStorage.setItem("nl-admin-token", token);
        $("tela-login").classList.add("escondido");
        $("dashboard").classList.remove("escondido");
        carregar();
        carregarInbox();
      }

      if (TOKEN) entrar(TOKEN);
    </script>
  </body>
</html>