<!doctype html>
<html lang="pt-br">
<head>
<meta charset="UTF-8" /><meta name="viewport" content="width=device-width" /><meta name="robots" content="noindex,nofollow" /><title>Admin · Sálvio Gonçalves</title>
<style>
:root{--ivory:#faf7f2;--sand:#f1ebe2;--line:#e2dacd;--ink:#2c2723;--muted:#6e655c;--sage:#4e6351;--sage-soft:#e5efe6;--red:#b3474d;--white:#fff}
*{box-sizing:border-box}body{margin:0;background:var(--sand);color:var(--ink);font-family:Georgia,"Times New Roman",serif;min-height:100vh;padding:28px 16px}.shell{max-width:980px;margin:auto}.card{background:var(--ivory);border:1px solid var(--line);border-radius:18px;padding:24px;margin-bottom:18px;box-shadow:0 4px 18px rgba(44,39,35,.035)}h1{margin:0 0 4px;color:var(--sage);font-size:24px}h2{margin:0 0 14px;color:var(--sage);font-size:14px;letter-spacing:.14em;text-transform:uppercase}.sub{color:var(--muted);font-size:13px;margin:0 0 18px}input,textarea,button{font:inherit;font-size:14px;border:1px solid var(--line);background:var(--white);color:var(--ink);padding:11px 16px;border-radius:999px}input,textarea{min-width:0}input:focus,textarea:focus{outline:2px solid rgba(78,99,81,.2);border-color:var(--sage)}button{background:var(--sage);border-color:var(--sage);color:var(--ivory);font-weight:600;cursor:pointer}button:hover{opacity:.9}button.outline{background:transparent;color:var(--sage)}button.danger{background:transparent;border-color:var(--red);color:var(--red);font-size:12px;padding:7px 12px}.row{display:flex;gap:10px;align-items:center}.hidden{display:none!important}.msg{display:none;margin-top:12px;padding:10px 14px;border-radius:10px;font-size:13px}.msg.ok{display:block;background:var(--sage-soft);color:var(--sage)}.msg.err{display:block;background:#f3e3e4;color:var(--red)}.tabs{display:flex;gap:8px;margin-bottom:18px;flex-wrap:wrap}.tab{background:var(--ivory);border-color:var(--line);color:var(--muted)}.tab.active{background:var(--sage);border-color:var(--sage);color:var(--ivory)}.badge{font-size:11px;background:var(--red);color:white;padding:2px 7px;border-radius:99px;margin-left:6px}.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:10px}.stat{background:var(--sand);border-radius:13px;text-align:center;padding:14px}.stat b{font-size:25px;color:var(--sage);display:block}.stat span{font-size:12px;color:var(--muted)}.toolbar{display:flex;gap:9px;align-items:center;flex-wrap:wrap;margin-bottom:16px}.search{flex:1;min-width:220px}.filter{padding:9px 14px}.email-list{display:grid;gap:9px}.email-card{display:grid;grid-template-columns:34px minmax(150px,1.2fr) minmax(170px,2fr) auto auto;gap:12px;align-items:center;background:var(--white);border:1px solid var(--line);border-radius:14px;padding:14px 15px;cursor:pointer;transition:.15s}.email-card:hover{border-color:var(--sage);transform:translateY(-1px)}.email-card.unread{background:#f8fbf8;border-left:4px solid var(--sage);font-weight:700}.avatar{width:32px;height:32px;border-radius:50%;background:var(--sage);color:var(--ivory);display:grid;place-items:center;font-size:13px}.from,.subject{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.preview{font-size:13px;color:var(--muted);font-weight:400;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.date{font-size:12px;color:var(--muted);white-space:nowrap}.star{border:0;background:transparent;color:#ad9d81;font-size:20px;padding:0;line-height:1}.star.on{color:#b97a5a}.empty{text-align:center;color:var(--muted);padding:28px 10px}.reader-head{display:flex;justify-content:space-between;gap:12px;align-items:flex-start}.reader-meta{color:var(--muted);font-size:13px;margin:5px 0 18px}.reader-body{background:var(--sand);border-radius:13px;padding:20px;line-height:1.7;white-space:pre-wrap;word-break:break-word;min-height:130px}.reader-actions{display:flex;gap:9px;flex-wrap:wrap;margin-top:16px}.reply{margin-top:16px}.reply textarea{width:100%;min-height:140px;border-radius:13px;resize:vertical}.table-wrap{overflow:auto}table{width:100%;border-collapse:collapse;font-size:13px}th{text-align:left;color:var(--muted);padding:8px;border-bottom:1px solid var(--line)}td{padding:9px 8px;border-bottom:1px solid var(--sand)}.pill{font-size:11px;border-radius:99px;padding:3px 9px;background:var(--sage-soft);color:var(--sage)}
@media(max-width:680px){body{padding:16px 10px}.card{padding:18px}.stats{grid-template-columns:repeat(2,1fr)}.email-card{grid-template-columns:32px 1fr auto;gap:8px}.email-card .preview{grid-column:2/4}.email-card .date{grid-column:3;grid-row:1}.email-card .star{grid-column:1;grid-row:2}.email-card .from{grid-column:2;grid-row:1}.email-card .subject{grid-column:2;grid-row:2}.email-card .date{grid-column:3;grid-row:1}.row{flex-wrap:wrap}.row input{width:100%}}
</style></head>
<body><div class="shell">
<div class="card" id="login"><h1>Admin · Sálvio Gonçalves</h1><p class="sub">Área privada — newsletter e caixa de entrada</p><form id="login-form" class="row"><input id="password" type="password" placeholder="Senha do admin" autocomplete="current-password"/><button>Entrar</button></form><p id="login-msg" class="msg"></p></div>
<div id="app" class="hidden">
<div class="tabs"><button class="tab active" data-tab="inbox">Caixa de entrada <span id="unread-badge" class="badge hidden">0</span></button><button class="tab" data-tab="news">Newsletter</button><button id="logout" class="danger">Sair</button></div>
<section id="inbox-tab"><div class="card"><div class="reader-head"><div><h1>Caixa de entrada</h1><p class="sub">Mensagens recebidas em @salviogoncalves.com.br</p></div><button id="refresh" class="outline">Atualizar</button></div><div class="toolbar"><input id="search" class="search" placeholder="⌕  Buscar por remetente, assunto ou conteúdo..."/><button class="filter active-filter" data-filter="inbox">Todos</button><button class="filter" data-filter="unread">Não lidos</button><button class="filter" data-filter="favorite">Favoritos</button><button class="filter" data-filter="archive">Arquivados</button></div><div id="email-list" class="email-list"></div></div><div id="reader" class="card hidden"><div class="reader-head"><div><h2 id="r-subject">Mensagem</h2><p id="r-meta" class="reader-meta"></p></div><button id="close-reader" class="outline">← Voltar</button></div><div id="r-body" class="reader-body"></div><div class="reader-actions"><button id="reply-toggle">Responder</button><button id="archive" class="outline">Arquivar</button><button id="delete" class="danger">Apagar</button></div><div id="reply-box" class="reply hidden"><textarea id="reply-text" placeholder="Escreva sua resposta..."></textarea><div class="reader-actions"><button id="send-reply">Enviar resposta</button></div></div><p id="inbox-msg" class="msg"></p></div></section>
<section id="news-tab" class="hidden"><div class="card"><h1>Newsletter · painel</h1><p class="sub">Lista e envios automáticos</p><div class="stats"><div class="stat"><b id="active-count">–</b><span>ativos</span></div><div class="stat"><b id="new-count">–</b><span>novos (7 dias)</span></div><div class="stat"><b id="unsub-count">–</b><span>cancelados</span></div><div class="stat"><b id="total-count">–</b><span>total</span></div></div><div class="toolbar" style="margin-top:16px"><button id="send-news">Enviar newsletter agora</button><button id="export" class="outline">Exportar CSV</button></div><p id="news-msg" class="msg"></p></div><div class="card"><h2>Inscritos</h2><div class="toolbar"><input id="sub-search" class="search" placeholder="Buscar e-mail..."/><button id="add-toggle" class="outline">+ Adicionar</button></div><div id="add-row" class="row hidden" style="margin-bottom:12px"><input id="new-email" type="email" placeholder="novo@email.com"/><button id="add">Adicionar</button></div><div class="table-wrap"><table><thead><tr><th>E-mail</th><th>Status</th><th>Data</th><th></th></tr></thead><tbody id="subs"></tbody></table></div></div><div class="card"><h2>Últimos envios</h2><div class="table-wrap"><table><thead><tr><th>Data</th><th>Para</th><th>Assunto</th><th>Status</th></tr></thead><tbody id="sent"></tbody></table></div></div></section>
</div></div>
<script>
const API="/.netlify/functions/admin", INBOX="/.netlify/functions/inbox";let token=sessionStorage.getItem("nl-admin-token")||"",messages=[],current=null,filter="inbox";const $=id=>document.getElementById(id);const esc=s=>String(s??"").replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;","\"":"&quot;","'":"&#39;"}[c]));
function notice(id,text,type="ok"){const e=$(id);e.textContent=text;e.className="msg "+type;setTimeout(()=>e.className="msg",5000)}
async function call(url,body){const r=await fetch(url,{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({...body,token})});return r.json()}
function initials(s){const x=String(s||"?").replace(/<.*>/,"").trim().split(/\s+/);return ((x[0]?.[0]||"")+(x[1]?.[0]||"")).toUpperCase()||"?"}
function renderInbox(){const q=$("search").value.toLowerCase().trim(),list=$("email-list");let xs=messages.filter(m=>{const hay=[m.from,m.subject,m.text].join(" ").toLowerCase();if(q&&!hay.includes(q))return false;if(filter==="unread")return !m.read;if(filter==="favorite")return m.favorite;if(filter==="archive")return m.folder==="archive";return m.folder!=="archive"&&m.folder!=="trash"});list.innerHTML=xs.length?xs.map(m=>{const date=m.receivedAt?new Date(m.receivedAt).toLocaleString("pt-BR",{day:"2-digit",month:"2-digit",hour:"2-digit",minute:"2-digit"}):"";return `<div class="email-card ${m.read?"":"unread"}" data-id="${esc(m.id)}"><span class="avatar">${initials(m.from)}</span><span class="from">${esc(m.from)}</span><span class="subject">${esc(m.subject)}</span><span class="preview">${esc((m.text||"").replace(/\s+/g," ").slice(0,120))}</span><span class="date">${date}</span><button class="star ${m.favorite?"on":""}" data-star="${esc(m.id)}">${m.favorite?"★":"☆"}</button></div>`}).join(""):`<div class="empty">Nenhuma mensagem nesta visualização.</div>`;list.querySelectorAll(".email-card").forEach(e=>e.addEventListener("click",()=>openMessage(e.dataset.id)));list.querySelectorAll("[data-star]").forEach(b=>b.addEventListener("click",async e=>{e.stopPropagation();await call(INBOX,{action:"set-meta",id:b.dataset.star,value:"favorite"});loadInbox()}))}
async function loadInbox(){const r=await call(INBOX,{action:"list"});if(!r.ok)return;messages=r.msgs;const n=r.unread;$("unread-badge").textContent=n;$("unread-badge").classList.toggle("hidden",!n);renderInbox()}
async function openMessage(id){const r=await call(INBOX,{action:"read",id});if(!r.ok)return;current=r.msg;$("reader").classList.remove("hidden");$("r-subject").textContent=current.subject;$("r-meta").textContent=`De: ${current.from}  ·  Para: ${current.to||"contato@salviogoncalves.com.br"}  ·  ${new Date(current.receivedAt).toLocaleString("pt-BR")}`;$("r-body").textContent=current.text||"(mensagem sem texto)"];$("reply-box").classList.add("hidden");loadInbox();window.scrollTo({top:document.body.scrollHeight,behavior:"smooth"})}
async function loadNews(){const r=await call(API,{action:"list"});if(!r.ok)return;$("active-count").textContent=r.stats.active;$("new-count").textContent=r.stats.newThisWeek;$("unsub-count").textContent=r.stats.unsubscribed;$("total-count").textContent=r.stats.total;const q=$("sub-search").value.toLowerCase();$("subs").innerHTML=r.subs.filter(s=>s.email.includes(q)).map(s=>`<tr><td>${esc(s.email)}</td><td><span class="pill">${s.status==="active"?"ativo":"cancelado"}</span></td><td>${s.subscribedAt?new Date(s.subscribedAt).toLocaleDateString("pt-BR"):"—"}</td><td><button class="danger" data-del="${esc(s.email)}">remover</button></td></tr>`).join("");$("subs").querySelectorAll("[data-del]").forEach(b=>b.onclick=async()=>{if(confirm("Remover este inscrito?")){await call(API,{action:"delete",email:b.dataset.del});loadNews()}});const e=await call(API,{action:"emails"});if(e.ok)$("sent").innerHTML=e.emails.map(x=>`<tr><td>${new Date(x.created_at).toLocaleString("pt-BR")}</td><td>${esc(x.to)}</td><td>${esc(x.subject)}</td><td>${esc(x.last_event)}</td></tr>`).join("")}
function enter(t){token=t;sessionStorage.setItem("nl-admin-token",t);$("login").classList.add("hidden");$("app").classList.remove("hidden");loadInbox();loadNews()};function logout(){token="";sessionStorage.removeItem("nl-admin-token");location.reload()}
$("login-form").onsubmit=async e=>{e.preventDefault();const r=await fetch(API,{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({action:"login",password:$("password").value})}).then(x=>x.json());r.ok?enter(r.token):notice("login-msg",r.error,"err")};$("logout").onclick=logout;$("refresh").onclick=loadInbox;$("search").oninput=renderInbox;$("close-reader").onclick=()=>$("reader").classList.add("hidden");document.querySelectorAll(".filter").forEach(b=>b.onclick=()=>{document.querySelectorAll(".filter").forEach(x=>x.classList.remove("active-filter"));b.classList.add("active-filter");filter=b.dataset.filter;renderInbox()});$("reply-toggle").onclick=()=>$("reply-box").classList.toggle("hidden");$("send-reply").onclick=async()=>{const text=$("reply-text").value.trim();if(!text)return;$("send-reply").disabled=true;const to=(current.from.match(/<([^>]+)>/)||[,current.from])[1];const r=await call(INBOX,{action:"reply",to,subject:"Re: "+current.subject,text});$("send-reply").disabled=false;r.ok?(($("reply-text").value=""),notice("inbox-msg","Resposta enviada!")):notice("inbox-msg",r.error,"err")};$("archive").onclick=async()=>{await call(INBOX,{action:"set-meta",id:current.id,value:"archive"});$("reader").classList.add("hidden");loadInbox()};$("delete").onclick=async()=>{if(confirm("Apagar esta mensagem?")){await call(INBOX,{action:"set-meta",id:current.id,value:"trash"});$("reader").classList.add("hidden");loadInbox()}};document.querySelectorAll(".tab").forEach(b=>b.onclick=()=>{document.querySelectorAll(".tab").forEach(x=>x.classList.remove("active"));b.classList.add("active");$("inbox-tab").classList.toggle("hidden",b.dataset.tab!=="inbox");$("news-tab").classList.toggle("hidden",b.dataset.tab!=="news");if(b.dataset.tab==="news")loadNews()});$("sub-search").oninput=loadNews;$("add-toggle").onclick=()=>$("add-row").classList.toggle("hidden");$("add").onclick=async()=>{await call(API,{action:"add",email:$("new-email").value});$("new-email").value="";loadNews()};$("send-news").onclick=async()=>{if(confirm("Enviar newsletter agora?")){const r=await call(API,{action:"send"});notice("news-msg",r.message||r.error,r.ok?"ok":"err")}};$("export").onclick=()=>window.open(`${API}?token=${encodeURIComponent(token)}&export=1`);if(token)enter(token);
</script></body></html>