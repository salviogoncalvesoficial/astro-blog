function renderInbox(){const q=($("search")||$("search-m")).value.toLowerCase().trim(),list=$("email-list");const base=messages.filter(m=>{if(filter==="unread")return!m.read;if(filter==="favorite")return m.favorite;if(filter==="archive")return m.folder==="archive";if(filter==="sent")return m.folder==="sent";return m.folder!=="archive"&&m.folder!=="trash"});const xs=q?base.filter(m=>[m.from,m.subject,m.text].join(" ").toLowerCase().includes(q)):base;const titles={inbox:"Cx. Entrada",unread:"Não lidos",favorite:"Favoritos",archive:"Arquivados",sent:"Enviados"};$("inbox-title").textContent=titles[filter]+" ("+base.length+")";$("write").classList.toggle("hidden",filter!=="inbox");list.innerHTML=xs.length?xs.map(m=>{const d=(m.receivedAt||m.sentAt)?new Date(m.receivedAt||m.sentAt).toLocaleString("pt-BR",{day:"2-digit",month:"2-digit",hour:"2-digit",minute:"2-digit"}):"";const isSent=m.folder==="sent";const mm=m.from.match(/^\s*([^<]+?)\s*<([^>]+)>\s*$/);const nm=(mm?mm[1]:m.from.split("@")[0]).replace(/^"|"$/g,"");const em=mm?mm[2]:m.from;const dispName=isSent?"Para: "+(m.to||"—"):nm;const dispAddr=isSent?"":em;return`<div class="email-card ${m.read?"":"unread"}" data-id="${esc(m.id)}"><div class="ec-top"><span class="avatar">${initials(m.from)}</span><span class="sender"><span class="from">${esc(dispName)}</span>${isSent?"":`<span class="email-addr">${esc(em)}</span>`}</span><button class="star" data-star="${esc(m.id)}" title="${m.favorite?"Remover favorito":"Favoritar"}">${starSVG(m.favorite)}</button></div><div class="ec-mid"><span class="ec-subject">${esc(m.subject)}</span><span class="date">${d}</span></div><div class="ec-preview">${esc((m.text||"").replace(/\s+/g," ").trim().slice(0,180))}</div></div>`}).join(""):`<div class="empty">Nenhuma mensagem nesta visualização.</div>`;list.querySelectorAll(".email-card").forEach(e=>e.onclick=()=>openMessage(e.dataset.id));list.querySelectorAll("[data-star]").forEach(b=>b.onclick=async e=>{e.stopPropagation();const m=message