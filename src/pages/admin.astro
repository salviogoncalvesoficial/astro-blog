function renderPosts(){const q=$("post-search").value.toLowerCase().trim();const xs=posts.filter(p=>!q||[p.title,p.tags.join(" ")].join(" ").toLowerCase().includes(q));$("post-list").innerHTML=xs.length?xs.map(p=>{const d=p.pubDatetime?new Date(p.pubDatetime).toLocaleDateString("pt-BR",{day:"2-digit",month:"short",year:"numeric"}):"";return`<div class="post-card" data-file="${esc(p.file)}"><div class="post-top"><span class="post-title">${esc(p.title)}</span>${p.draft?'<span class="pill draft">Rascunho</span>':""}${p.featured?'<span class="pill feat">★ Destaque</span>':""}</div><div class="post-meta"><span>${d}</span>${p.tags.map(t=>`<span class="tagchip">${esc(t)}</span>`).join("")}</div></div>`}).join(""):'<div class="empty">Nenhum post encontrado.</div>';$("post-list").querySelectorAll(".post-card").forEach(c=>c.onclick=()=>openPost(c.dataset.file))}
async function loadPosts(){const r=await call(POSTS,{action:"list"});if(!r.ok)return notice("pe-msg",r.error||"Erro ao carregar posts","err");posts=r.posts;renderPosts()}
function openEditorNew(){$("blog-list-card").classList.add("hidden");$("post-editor").classList.remove("hidden");$("app").classList.add("composing");curFile=null;previewOn=false;$("pe-head").textContent="Novo post";$("pe-title").value="";$("pe-desc").value="";$("pe-date").value=new Date().toISOString().slice(0,10);$("pe-tags").value="";$("pe-draft").checked=false;$("pe-feat").checked=false;$("p-body").value="";$("pe-msg").className="msg";$("pe-delete").classList.add("hidden");$("pe-view").classList.add("hidden");$("pe-preview").textContent="👁 Prévia";$("p-body").classList.remove("hidden");$("p-preview").classList.add("hidden");window.scrollTo({top:0,behavior:"smooth"})}
async function openPost(file){const r=await call(POSTS,{action:"get",file});if(!r.ok)return notice("pe-msg",r.error,"err");$("blog-list-card").classList.add("hidden");$("post-editor").classList.remove("hidden");$("app").classList.add("composing");curFile=file;previewOn=false;const p=r.post;$("pe-head").textContent="Editar post";$("pe-title").value=p.title;$("pe-desc").value=p.description;const d=p.pubDatetime?new Date(p.pubDatetime):new Date();$("pe-date").value=isNaN(d)?new Date().toISOString().slice(0,10):d.toISOString().slice(0,10);$("pe-tags").value=p.tags.join(", ");$("pe-draft").checked=p.draft;$("pe-feat").checked=p.featured;$("p-body").value=p.body;$("pe-msg").className="msg";$("pe-delete").classList.remove("hidden");$("pe-view").classList.remove("hidden");$("pe-preview").textContent="👁 Prévia";$("p-body").classList.remove("hidden");$("p-preview").classList.add("hidden");window.scrollTo({top:0,behavior:"smooth"})}
function closeEditor(){$("post-editor").classList.add("hidden");$("app").classList.remove("composing");$("blog-list-card").classList.remove("hidden");loadPosts()}
function wrapSel(before,after,ph){const t=$("p-body");const a=t.selectionStart,b=t.selectionEnd;const sel=t.value.slice(a,b)||ph||"";t.value=t.value.slice(0,a)+before+sel+after+t.value.slice(b);t.focus();t.setSelectionRange(a+before.length,a+before.length+sel.length)}
document.querySelectorAll(".editor-bar [data-md]").forEach(b=>b.onclick=()=>{const k=b.dataset.md,t=$("p-body");if(k==="h2")wrapSel("\n## ","\n","Título");else if(k==="h3")wrapSel("\n### ","\n","Subtítulo");else if(k==="b")wrapSel("**","**","negrito");else if(k==="i")wrapSel("*","*","itálico");else if(k==="ul")wrapSel("\n- ","","item da lista");else if(k==="quote")wrapSel("\n> ","","citação");else if(k==="link"){const url=prompt("URL do link:");if(url)wrapSel("[",`](${url})`,"texto do link")}else if(k==="img"){const url=prompt("URL da imagem (ou use 📎 Enviar imagem):");if(url)wrapSel("\n![",`](${url})`,"descrição")}});
$("pe-preview").onclick=()=>{previewOn=!previewOn;if(previewOn){$("p-preview").innerHTML=mdToHtml($("p-body").value);$("p-body").classList.add("hidden");$("p-preview").classList.remove("hidden");$("pe-preview").textContent="✏️ Editar"}else{$("p-body").classList.remove("hidden");$("p-preview").classList.add("hidden");$("pe-preview").textContent="👁 Prévia"}};
$("pe-img").onchange=async e=>{const f=e.target.files[0];if(!f)return;if(f.size>4*1024*1024)return notice("pe-msg","Imagem muito grande (máx 4 MB)","err");$("img-status").textContent="Enviando...";const rd=new FileReader();rd.onload=async()=>{const r=await call(POSTS,{action:"upload",name:f.name,data:rd.result});$("img-status").textContent=r.ok?"Enviada ✓":"Falhou";if(r.ok){wrapSel("\n![",`](${r.path})`,"descrição da imagem");notice("pe-msg","Imagem enviada e inserida no post!")}setTimeout(()=>$("img-status").textContent="",4000)};rd.readAsDataURL(f)};
$("pe-save").onclick=async()=>{const title=$("pe-title").value.trim(),bodyMd=$("p-body").value;if(!title||!bodyMd.trim())return notice("pe-msg","Preencha pelo menos o título e o conteúdo.","err");const b=$("pe-save");b.disabled=true;b.textContent="Salvando...";const r=await call(POSTS,{action:"save",file:curFile,post:{title,description:$("pe-desc").value.trim(),pubDatetime:$("pe-date").value,tags:$("pe-tags").value,draft:$("pe-draft").checked,featured:$("pe-feat").checked,body:bodyMd}});b.disabled=false;b.textContent="Salvar";if(r.ok){notice("pe-msg","Salvo! O blog atualiza em ~2 minutos.");setTimeout(closeEditor,1200)}else notice("pe-msg",r.error,"err")};
$("pe-delete").onclick=async()=>{if(!curFile)return;if(!confirm("Apagar este post do blog?"))return;const r=await call(POSTS,{action:"delete",file:curFile});if(r.ok){notice("pe-msg","Post apagado.");setTimeout(closeEditor,800)}else notice("pe-msg",r.error,"err")};
$("pe-close").onclick=closeEditor;$("post-new").onclick=openEditorNew;$("post-search").oninput=renderPosts;
document.querySelectorAll(".tab").forEach(b=>b.onclick=()=>{document.querySelectorAll(".tab").forEach(x=>x.classList.remove("active"));b.classList.add("active");$("inbox-tab").classList.toggle("hidden",b.dataset.tab!=="inbox");$("news-tab").classList.toggle("hidden",b.dataset.tab!=="news");$("blog-tab").classList.toggle("hidden",b.dataset.tab!=="blog");$("write").classList.toggle("hidden",b.dataset.tab!=="inbox"||filter!=="inbox");if(b.dataset.tab==="news")loadNews();if(b.dataset.tab==="blog"&&!posts.length)loadPosts()});$("sub-search").oninput=loadNews;$("add-toggle").onclick=()=>$("add-row").classList.toggle("hidden");$("add").onclick=async()=>{await call(API,{action:"add",email:$("new-email").value});$("new-email").value="";loadNews()};$("send-news").onclick=async()=>{if(confirm("Enviar newsletter agora?")){const r=await call(API,{action:"send"});notice("news-msg",r.message||r.error,r.ok?"ok":"err")}};$("export").onclick=()=>window.open(`${API}?token=${encodeURIComponent(token)}&export=1`);if(token)enter(token);</script></body></html>