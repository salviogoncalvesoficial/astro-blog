<script>const API="/.netlify/functions/admin",INBOX="/.netlify/functions/inbox";let token=sessionStorage.getItem("nl-admin-token")||"",messages=[],current=null,filter="inbox";const $=id=>document.getElementById(id),esc=s=>String(s??"").replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;","\"":"&quot;","'":"&#39;"}[c]));function notice(id,text,type="ok"){const e=$(id);e.textContent=text;e.className="msg "+type;setTimeout(()=>e.className="msg",5000)}async function call(url,body){return fetch(url,{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({...body,token})}).then(r=>r.json())}function initials(s){const x=String(s||"?").replace(/<.*>/,"").trim().split(/\s+/);return((x[0]?.[0]||"")+(x[1]?.[0]||"")).toUpperCase()||"?"}const starSVG=f=>`<svg viewBox="0 0 24 24" width="19" height="19" fill="${f?"#b97a5a":"none"}" stroke="#b97a5a" stroke-width="1.7" stroke-linejoin="round"><path d="M12 2.5l3.05 6.18 6.82.99-4.93 4.81 1.16 6.79L12 18.06l-6.1 3.21 1.16-6.79-4.93-4.81 6.82-.99L12 2.5z"/></svg>`;
function renderInbox(){const q=($("search")||$("search-m")).value.toLowerCase().trim(),list=$("email-list");let xs=messages.filter(m=>{const hay=[m.from,m.subject,m.text].join(" ").toLowerCase();if(q&&!hay.includes(q))return false;if(filter==="unread")return!m.read;if(filter==="favorite")return m.favorite;if(filter==="archive")return m.folder==="archive";return m.folder!=="archive"&&m.folder!=="trash"});list.innerHTML=xs.length?xs.map(m=>{const d=m.receivedAt?new Date(m.receivedAt).toLocaleString("pt-BR",{day:"2-digit",month:"2-digit",hour:"2-digit",minute:"2-digit"}):"";return`<div class="email-card ${m.read?"":"unread"}" data-id="${esc(m.id)}"><div class="ec-top"><span class="avatar">${initials(m.from)}</span><span class="from">${esc(m.from)}</span><button class="star" data-star="${esc(m.id)}" title="${m.favorite?"Remover favorito":"Favoritar"}">${starSVG(m.favorite)}</button></div><div class="ec-mid"><span class="ec-subject">${esc(m.subject)}</span><span class="date">${d}</span></div><div class="ec-preview">${esc((m.text||"").replace(/\s+/g," ").trim().slice(0,180))}</div></div>`}).join(""):`<div class="empty">Nenhuma mensagem nesta visualização.</div>`;list.querySelectorAll(".email-card").forEach(e=>e.onclick=()=>openMessage(e.dataset.id));list.querySelectorAll("[data-star]").forEach(b=>b.onclick=async e=>{e.stopPropagation();await call(INBOX,{action:"set-meta",id:b.dataset.star,value:"favorite"});loadInbox()})}
async function loadInbox(){const r=await call(INBOX,{action:"list"});if(!r.ok)return;messages=r.msgs;$("badge").textContent=r.unread;$("badge").classList.toggle("hidden",!r.unread);renderInbox()}
let refreshing=false;async function doRefresh(){if(refreshing)return;refreshing=true;$("spinner").classList.add("show");try{await loadInbox()}finally{$("spinner").classList.remove("show");refreshing=false}}
let pullY=null;document.addEventListener("touchstart",e=>{if(window.scrollY<=0&&!$("app").classList.contains("hidden")&&$("reader").classList.contains("hidden")){pullY=e.touches[0].clientY}},{passive:true});document.addEventListener("touchmove",e=>{if(pullY!==null&&window.scrollY<=0&&e.touches[0].clientY-pullY>80){pullY=null;doRefresh()}},{passive:true});document.addEventListener("touchend",()=>pullY=null);
function setFavBtn(){const b=$("fav");b.classList.toggle("on",!!current.favorite);b.innerHTML=current.favorite?"★ Favoritado":"☆ Favoritar"}async function openMessage(id){const r=await call(INBOX,{action:"read",id});if(!r.ok)return;current=r.msg;$("app").classList.add("reading");$("reader").classList.remove("hidden");$("r-subject").textContent=current.subject;$("r-meta").textContent=`De: ${current.from} · Para: ${current.to||"contato@salviogoncalves.com.br"} · ${new Date(current.receivedAt).toLocaleString("pt-BR")}`;$("r-body").textContent=current.text||"(mensagem sem texto)";$("reply-box").classList.add("hidden");setFavBtn();$("archive").textContent=current.folder==="archive"?"Desarquivar":"Arquivar";loadInbox();window.scrollTo({top:0,behavior:"smooth"})}function closeMessage(){$("app").classList.remove("reading");$("reader").classList.add("hidden")}async function loadNews(){const r=await call(API,{action:"list"});if(!r.ok)return;$("active").textContent=r.stats.active;$("new").textContent=r.stats.newThisWeek;$("unsub").textContent=r.stats.unsubscribed;$("total").textContent=r.stats.total;const q=$("sub-search").value.toLowerCase();$("subs").innerHTML=r.subs.filter(s=>s.email.includes(q)).map(s=>`<tr><td>${esc(s.email)}</td><td>${s.status}</td><td>${s.subscribedAt?new Date(s.subscribedAt).toLocaleDateString("pt-BR"):"—"}</td><td><button class="danger" data-del="${esc(s.email)}">remover</button></td></tr>`).join("");$("subs").querySelectorAll("[data-del]").forEach(b=>b.onclick=async()=>{if(confirm("Remover este inscrito?")){await call(API,{action:"delete",email:b.dataset.del});loadNews()}});const e=await call(API,{action:"emails"});if(e.ok)$("sent").innerHTML=e.emails.map(x=>`<tr><td>${new Date(x.created_at).toLocaleString("pt-BR")}</td><td>${esc(x.to)}</td><td>${esc(x.subject)}</td><td>${esc(x.last_event)}</td></tr>`).join("")}function enter(t){token=t;sessionStorage.setItem("nl-admin-token",t);$("login").classList.add("hidden");$("app").classList.remove("hidden");loadInbox();loadNews()}function logout(){token="";sessionStorage.removeItem("nl-admin-token");location.reload()}$("login-form").onsubmit=async e=>{e.preventDefault();const r=await fetch(API,{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({action:"login",password:$("password").value})}).then(x=>x.json());r.ok?enter(r.token):notice("login-msg",r.error,"err")};$("logout").onclick=logout;$("refresh").onclick=doRefresh;$("menu-btn").onclick=e=>{e.stopPropagation();if(window.innerWidth<=680){$("toolbar").classList.toggle("filters-open");$("toolbar").classList.remove("search-open")}else{$("desk-filters").classList.toggle("open")}};$("search-btn").onclick=e=>{e.stopPropagation();const tb=$("toolbar");tb.classList.toggle("search-open");tb.classList.remove("filters-open");if(tb.classList.contains("search-open"))setTimeout(()=>$("search-m").focus(),50)};$("toolbar").onclick=e=>e.stopPropagation();document.addEventListener("click",e=>{const tb=$("toolbar");if(!tb.contains(e.target)&&!$("menu-btn").contains(e.target)&&!$("search-btn").contains(e.target)){tb.classList.remove("filters-open");tb.classList.remove("search-open")}$("desk-filters").classList.remove("open")});const syncSearch=v=>{$("search").value=v;$("search-m").value=v;renderInbox()};$("search").oninput=e=>syncSearch(e.target.value);$("search-m").oninput=e=>syncSearch(e.target.value);$("close").onclick=closeMessage;document.querySelectorAll(".filter").forEach(b=>b.onclick=()=>{document.querySelectorAll(".filter").forEach(x=>x.classList.remove("active-filter"));b.classList.add("active-filter");filter=b.dataset.filter;$("toolbar").classList.remove("filters-open");$("desk-filters").classList.remove("open");renderInbox()});$("reply-toggle").onclick=()=>$("reply-box").classList.toggle("hidden");$("fav").onclick=async()=>{await call(INBOX,{action:"set-meta",id:current.id,value:"favorite"});current.favorite=!current.favorite;setFavBtn();loadInbox()};$("archive").onclick=async()=>{const archived=current.folder==="archive";await call(INBOX,{action:"set-meta",id:current.id,value:archived?"inbox":"archive"});closeMessage();loadInbox()};$("delete").onclick=async()=>{if(confirm("Apagar esta mensagem?")){await call(INBOX,{action:"set-meta",id:current.id,value:"trash"});closeMessage();loadInbox()}};$("send-reply").onclick=async()=>{const text=$("reply-text").value.trim();if(!text)return;$("send-reply").disabled=true;const to=(current.from.match(/<([^>]+)>/)||[,current.from])[1];const r=await call(INBOX,{action:"reply",to,subject:"Re: "+current.subject,text});$("send-reply").disabled=false;r.ok?($("reply-text").value="",notice("inbox-msg","Resposta enviada!")):notice("inbox-msg",r.error,"err")};document.querySelectorAll(".tab").forEach(b=>b.onclick=()=>{document.querySelectorAll(".tab").forEach(x=>x.classList.remove("active"));b.classList.add("active");$("inbox-tab").classList.toggle("hidden",b.dataset.tab!=="inbox");$("news-tab").classList.toggle("hidden",b.dataset.tab!=="news");if(b.dataset.tab==="news")loadNews()});$("sub-search").oninput=loadNews;$("add-toggle").onclick=()=>$("add-row").classList.toggle("hidden");$("add").onclick=async()=>{await call(API,{action:"add",email:$("new-email").value});$("new-email").value="";loadNews()};$("send-news").onclick=async()=>{if(confirm("Enviar newsletter agora?")){const r=await call(API,{action:"send"});notice("news-msg",r.message||r.error,r.ok?"ok":"err")}};$("export").onclick=()=>window.open(`${API}?token=${encodeURIComponent(token)}&export=1`);if(token)enter(token);</script></body></html>