</style></head><body><div class="shell"><div class="card" id="login"><h1>Admin · Sálvio Gonçalves</h1><p class="sub">Newsletter e caixa de entrada</p><form id="login-form" class="row"><input id="password" type="password" placeholder="Senha do admin"/><button>Entrar</button></form><p id="login-msg" class="msg"></p></div><div id="app" class="hidden"><div class="tabs"><button class="tab active" data-tab="inbox">Caixa de entrada <span id="badge" class="badge hidden">0</span></button><button class="tab" data-tab="news">Newsletter</button><button id="logout" class="danger">Sair</button></div>
