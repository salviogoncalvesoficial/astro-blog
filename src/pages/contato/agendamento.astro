---
import Layout from "@layouts/Layout.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import { SITE } from "@config";
---
<Layout title={`Agendamento | ${SITE.title}`} description="Escolha um horário para iniciarmos uma conversa com calma e acolhimento.">
  <Header />
  <main id="contact-page">
    <section class="contact-intro">
      <p class="eyebrow">Um espaço para você</p>
      <h1>Talvez este seja o momento de olhar para você com mais cuidado.</h1>
      <p class="lead">Vamos conversar sobre o que você está vivendo e encontrar, com calma, um próximo passo possível. Escolha um horário para iniciarmos essa conversa.</p>
      <p class="details">A conversa inicial tem duração de 60 minutos e acontece online, pelo Google Meet. Ao escolher um horário, você receberá a confirmação no e-mail informado pelo Google Agenda.</p>
    </section>
    <section class="booking-card" aria-labelledby="booking-title">
      <h2 id="booking-title">Escolha um horário</h2>
      <p>Encontre um momento que faça sentido para você.</p>
      <a class="booking-link" href="https://calendar.app.google/dUd6B3ge6TqjwNmf6" target="_blank" rel="noopener noreferrer">Abrir agenda de horários <span aria-hidden="true">↗</span></a>
      <div class="booking-frame-wrap">
        <iframe src="https://calendar.app.google/dUd6B3ge6TqjwNmf6" title="Agenda de horários para conversa inicial" loading="lazy"></iframe>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
<style>
  #contact-page{max-width:54rem;margin:0 auto;padding:4rem 1rem 5rem}
  .contact-intro{max-width:42rem;margin:0 auto 2.5rem;text-align:center}
  .eyebrow{display:inline-block;margin:0 0 1rem;border:1px solid rgb(var(--color-line));border-radius:999px;padding:.35rem .8rem;color:rgb(var(--color-accent));font-size:.75rem;text-transform:uppercase;letter-spacing:.16em}
  h1{margin:0;color:rgb(var(--color-accent));font-size:clamp(2rem,5vw,3.2rem);line-height:1.12}
  .lead{margin:1.4rem auto 0;max-width:38rem;font-size:1.15rem;line-height:1.75}
  .details{margin:1rem auto 0;max-width:36rem;color:rgb(var(--color-base)/.75);font-size:.95rem;line-height:1.65}
  .booking-card{margin:0 auto;border:1px solid rgb(var(--color-line));border-radius:1.5rem;background:rgb(var(--color-card));padding:clamp(1.25rem,4vw,2rem);box-shadow:0 12px 35px rgb(var(--color-base)/.06)}
  .booking-card h2{margin:0;color:rgb(var(--color-accent));font-size:1.4rem}
  .booking-card>p{margin:.45rem 0 1rem;color:rgb(var(--color-base)/.75)}
  .booking-link{display:inline-flex;align-items:center;gap:.45rem;margin-bottom:1.2rem;color:rgb(var(--color-accent));font-weight:600;text-decoration:underline;text-underline-offset:.2em}
  .booking-frame-wrap{overflow:hidden;border:1px solid rgb(var(--color-line));border-radius:1rem;background:rgb(var(--color-fill));min-height:680px}
  .booking-frame-wrap iframe{display:block;width:100%;height:680px;border:0;background:transparent}
  @media(max-width:640px){#contact-page{padding:2.5rem .75rem 4rem}.contact-intro{text-align:left;margin-bottom:2rem}.lead{font-size:1.05rem}.booking-frame-wrap{min-height:700px}.booking-frame-wrap iframe{height:700px}}
</style>